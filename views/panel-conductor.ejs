<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mi Panel - Transporte SST</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f0f2f5; padding: 15px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .dashboard-container { max-width: 600px; margin: 20px auto; }
        .user-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; }
        .card { border: none; border-radius: 10px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); overflow: hidden; }
    </style>
</head>
<body>
    <div class="dashboard-container">
        <div class="user-header">
            <h4><i class="fas fa-user-circle text-primary"></i> Hola, <%= usuario.nombre %></h4>
            <a href="/logout" class="btn btn-outline-danger btn-sm fw-bold"><i class="fas fa-sign-out-alt"></i> Salir</a>
        </div>

        <% if (inspeccionActiva) { %>
            <!-- TARJETA CUANDO TIENE UN TURNO ABIERTO (CIERRE DE JORNADA) -->
            <div class="card border-0">
                <div class="card-header bg-warning text-dark fw-bold p-3" style="font-size: 1.1rem;">
                    <i class="fas fa-exclamation-triangle"></i> Tienes una jornada en curso
                </div>
                <div class="card-body p-4">
                    <p class="mb-2"><i class="fas fa-car"></i> <strong>Vehículo:</strong> <span class="badge bg-dark fs-6"><%= inspeccionActiva.vehiculo_placa %></span></p>
                    <p class="mb-3"><i class="fas fa-clock"></i> <strong>Hora de salida:</strong> <%= new Date(inspeccionActiva.fecha_apertura).toLocaleTimeString('es-ES') %></p>
                    
                    <div class="alert alert-info">
                        Para finalizar tu día de trabajo, debes registrar el kilometraje de llegada y cerrar esta inspección.
                    </div>

                    <a href="/inspeccion/cierre/<%= inspeccionActiva.id %>" class="btn btn-warning btn-lg w-100 fw-bold mt-2 py-3 shadow-sm">
                        <i class="fas fa-flag-checkered"></i> CERRAR JORNADA AHORA
                    </a>
                </div>
            </div>
        <% } else { %>
            <!-- TARJETA CUANDO NO TIENE TURNOS ABIERTOS (INICIO DE JORNADA) -->
            <div class="card border-0">
                <div class="card-header bg-success text-white fw-bold p-3" style="font-size: 1.1rem;">
                    <i class="fas fa-check-circle"></i> Todo al día
                </div>
                <div class="card-body text-center p-5">
                    <i class="fas fa-clipboard-check text-success mb-3" style="font-size: 4rem; opacity: 0.5;"></i>
                    <h5 class="mb-4">No tienes ninguna jornada en curso.</h5>
                    
                    <a href="/inspeccion" class="btn btn-success btn-lg w-100 fw-bold py-3 shadow-sm">
                        <i class="fas fa-play-circle"></i> INICIAR NUEVA INSPECCIÓN
                    </a>
                </div>
            </div>
        <% } %>
    </div>
</body>
</html>