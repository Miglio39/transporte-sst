<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Mi Panel | OmegaGroup SAS</title>
    <link rel="icon" type="image/jpeg" href="/images/logo-app.jpg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        /* =========================================================
           DISEÑO EMPRESARIAL - PANEL CONDUCTOR
           ========================================================= */
        :root {
            --surface-bg: #f8fafc;
            --border-color: #e2e8f0;
            --text-main: #334155;
            --omega-dark: #0f172a;
            --omega-red: #e50914;
        }

        body { 
            background-color: var(--surface-bg); 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; 
            padding: 15px;
            color: var(--text-main);
        }

        .dashboard-container { 
            max-width: 500px; 
            margin: 20px auto; 
        }

        /* ENCABEZADO */
        .page-header {
            background: var(--omega-dark);
            color: white;
            padding: 20px 25px;
            border-radius: 12px 12px 0 0;
            border-bottom: 4px solid var(--omega-red);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .page-header h4 { margin: 0; font-weight: 700; font-size: 1.2rem; }
        
        .btn-outline-cancel { 
            border: 1px solid rgba(255,255,255,0.3); 
            color: white; 
            font-weight: 600; 
            background: transparent; 
            transition: all 0.2s; 
        }
        .btn-outline-cancel:hover { background-color: rgba(239, 68, 68, 0.2); border-color: #ef4444; color: white; }

        /* TARJETAS PRINCIPALES */
        .form-card {
            background: white;
            padding: 30px 25px;
            border-radius: 0 0 12px 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            border: 1px solid var(--border-color);
            border-top: none;
        }

        /* ESTILOS INTERNOS DE TARJETAS */
        .info-box {
            background: #f8fafc;
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 15px;
        }

        /* BOTONES DE ACCIÓN GIGANTES */
        .btn-omega { background: var(--omega-dark); color: white; border: none; font-weight: 700; transition: all 0.2s; letter-spacing: 0.5px;}
        .btn-omega:hover { background: #1e293b; color: white; transform: translateY(-2px); box-shadow: 0 8px 15px rgba(15, 23, 42, 0.2); }
        
        .btn-warning-action { background: #f59e0b; color: white; border: none; font-weight: 700; transition: all 0.2s; letter-spacing: 0.5px;}
        .btn-warning-action:hover { background: #d97706; color: white; transform: translateY(-2px); box-shadow: 0 8px 15px rgba(245, 158, 11, 0.3); }

        /* ANIMACIONES Y UTILIDADES */
        .icon-pulse {
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.1); }
            100% { transform: scale(1); }
        }
    </style>
</head>
<body>
    <div class="dashboard-container">
        
        <!-- ENCABEZADO DE USUARIO -->
        <div class="page-header">
            <div>
                <h4><i class="fas fa-user-circle me-2" style="color: var(--omega-red);"></i> <%= usuario.nombre.split(' ')[0] %></h4>
                <span class="small opacity-75" style="font-size: 0.75rem;">Operador Logístico | OmegaGroup</span>
            </div>
            <a href="/logout" class="btn btn-outline-cancel btn-sm">
                <i class="fas fa-sign-out-alt"></i> Salir
            </a>
        </div>

        <% if (inspeccionActiva) { %>
            <!-- ============================================== -->
            <!-- TARJETA: TIENE TURNO ABIERTO (CIERRE DE JORNADA) -->
            <!-- ============================================== -->
            <div class="form-card text-center">
                
                <div class="mb-4">
                    <div class="icon-pulse mb-3">
                        <i class="fas fa-truck-moving" style="font-size: 3.5rem; color: #f59e0b;"></i>
                    </div>
                    <h5 class="fw-bold" style="color: #92400e;">¡Ruta en Curso!</h5>
                    <p class="text-muted" style="font-size: 0.9rem;">Tienes una inspección abierta en el sistema.</p>
                </div>
                
                <div class="info-box text-start mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                        <span class="text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 1px;">VEHÍCULO</span>
                        <span class="badge bg-dark fs-6 px-3 py-2"><i class="fas fa-car-side me-1 opacity-50"></i> <%= inspeccionActiva.vehiculo_placa %></span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted fw-bold" style="font-size: 0.75rem; letter-spacing: 1px;">HORA DE SALIDA</span>
                        <span class="fw-bold text-primary fs-5">
                            <i class="far fa-clock me-1"></i> <%= new Date(inspeccionActiva.fecha_apertura).toLocaleTimeString('es-ES', {hour: '2-digit', minute:'2-digit'}) %>
                        </span>
                    </div>
                </div>

                <div class="alert text-start small border-0 mb-4" style="background-color: #fffbeb; color: #b45309; border-left: 4px solid #f59e0b !important; border-radius: 4px;">
                    <strong><i class="fas fa-info-circle me-1"></i> Acción Requerida:</strong><br>
                    Para finalizar tu turno y liberar el vehículo, debes registrar tu kilometraje de llegada.
                </div>

                <a href="/inspeccion/cierre/<%= inspeccionActiva.id %>" class="btn btn-warning-action w-100 py-3 fs-5 rounded-3">
                    <i class="fas fa-flag-checkered me-2"></i> CERRAR JORNADA
                </a>
            </div>

        <% } else { %>
            <!-- ============================================== -->
            <!-- TARJETA: NO TIENE TURNOS (INICIO DE JORNADA)     -->
            <!-- ============================================== -->
            <div class="form-card text-center">
                
                <div class="mb-4 pt-3">
                    <i class="fas fa-clipboard-check mb-4" style="font-size: 5rem; color: #10b981;"></i>
                    <h4 class="fw-bold text-dark mb-2">Todo al día</h4>
                    <p class="text-muted" style="font-size: 0.95rem;">No tienes ninguna jornada pendiente por cerrar. Estás listo para un nuevo recorrido.</p>
                </div>
                
                <hr style="border-color: var(--border-color); margin: 30px 0;">

                <a href="/inspeccion" class="btn btn-omega w-100 py-3 fs-5 rounded-3">
                    <i class="fas fa-play-circle me-2"></i> INICIAR NUEVA INSPECCIÓN
                </a>
            </div>
        <% } %>
        
        <div class="text-center mt-4">
            <span style="font-size: 0.75rem; color: #94a3b8; font-weight: 500;">&copy; <%= new Date().getFullYear() %> Plataforma Asegurada | OmegaGroup</span>
        </div>
    </div>
</body>
</html>