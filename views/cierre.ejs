<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
        <link rel="icon" type="image/jpeg" href="/images/logo-app.jpg">

    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %> - <%= appName %></title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f0f2f5; padding: 20px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        .card-cierre { max-width: 600px; margin: 0 auto; background: white; border-radius: 8px; box-shadow: 0 4px 15px rgba(0,0,0,0.1); overflow: hidden; }
        .header { background: linear-gradient(135deg, #e67e22, #d35400); color: white; padding: 20px; text-align: center; }
        .info-box { background: #f8f9fa; border-left: 4px solid #3498db; padding: 15px; margin-bottom: 20px; border-radius: 4px; }
    </style>
</head>
<body>
    <div class="card-cierre">
        <div class="header">
            <h2><i class="fas fa-flag-checkered"></i> CIERRE DE JORNADA</h2>
            <p class="mb-0">Inspección #<%= inspeccion.id %> | Placa: <strong><%= inspeccion.vehiculo.placa %></strong></p>
        </div>
        
        <div class="p-4">
            <div class="info-box">
                <p class="mb-1"><strong><i class="fas fa-user"></i> Conductor:</strong> <%= inspeccion.conductor.nombre %></p>
                <p class="mb-1"><strong><i class="fas fa-tachometer-alt"></i> Km de salida (mañana):</strong> <%= inspeccion.kilometraje_salida %> km</p>
                <p class="mb-0 text-muted"><small>Hora de apertura: <%= new Date(inspeccion.fecha_apertura).toLocaleTimeString('es-ES') %></small></p>
            </div>

            <form action="/inspeccion/cierre/<%= inspeccion.id %>" method="POST" id="cierreForm">
                <div class="mb-3">
                    <label class="form-label fw-bold text-dark">Kilometraje Final de Llegada <span class="text-danger">*</span></label>
                    <input type="number" class="form-control form-control-lg" name="kilometraje_final" id="kilometraje_final" 
                           placeholder="Ingrese el kilometraje final" required step="0.1" min="<%= inspeccion.kilometraje_salida %>">
                    <div class="form-text">Debe ser igual o mayor al kilometraje de salida de esta mañana.</div>
                </div>
                
                <div class="mb-4">
                    <label class="form-label fw-bold text-dark">Novedades al finalizar la jornada</label>
                    <textarea class="form-control" name="novedades" rows="4" 
                              placeholder="Escriba si ocurrió algún incidente, choque, falla mecánica, o deje en blanco si no hay novedades..."></textarea>
                </div>
                
                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-success btn-lg" id="btnSubmit">
                        <i class="fas fa-save"></i> FINALIZAR TURNO
                    </button>
                    <a href="/admin" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        document.getElementById('cierreForm').addEventListener('submit', function() {
            const btn = document.getElementById('btnSubmit');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> CERRANDO JORNADA...';
            btn.disabled = true;
        });
    </script>
</body>
</html>