<script>
// ============================================
// FUNCIONES DE VALIDACIÓN Y COLORES
// ============================================

function validarFormatoPlaca(placa) {
    const patrones = [ /^[A-Z]{3}\d{3}$/, /^[A-Z]{3}\d{2}[A-Z]$/, /^[A-Z]{2}\d{4}[A-Z]$/, /^[A-Z]\d{5}$/, /^\d{3}[A-Z]{3}$/, /^[A-Z]{2}\d{3}[A-Z]{2}$/ ];
    return patrones.some(patron => patron.test(placa));
}

// Función maestra para validar cualquier fecha de vencimiento
function validarVencimiento(inputId, nombreDoc) {
    const input = document.getElementById(inputId);
    if (!input || !input.value) return;

    const partes = input.value.split('-');
    const fecha = new Date(partes[0], partes[1] - 1, partes[2]);
    const hoy = new Date();
    hoy.setHours(0, 0, 0, 0);
    
    const diasRestantes = Math.ceil((fecha - hoy) / (1000 * 60 * 60 * 24));
    
    if (diasRestantes < 0) {
        input.style.borderColor = '#e74c3c'; input.style.background = '#f8d7da';
        input.title = `${nombreDoc} VENCIDO hace ${Math.abs(diasRestantes)} días`;
    } else if (diasRestantes <= 30) {
        input.style.borderColor = '#f39c12'; input.style.background = '#fff3cd';
        input.title = `${nombreDoc} vence en ${diasRestantes} días`;
    } else {
        input.style.borderColor = '#27ae60'; input.style.background = '#d4edda';
        input.title = `${nombreDoc} vigente por ${diasRestantes} días`;
    }
}

function validarTodasLasFechas() {
    validarVencimiento('fecha_vencimiento_soat', 'SOAT');
    validarVencimiento('fecha_revision', 'Tecno-mecánica');
    validarVencimiento('doc_poliza_rcc', 'Póliza RCC');
    validarVencimiento('doc_poliza_todo_riesgo', 'Póliza Todo Riesgo');
    validarVencimiento('doc_tarjeta_operacion', 'Tarjeta de Operación');
}

// ============================================
// EVENT LISTENERS
// ============================================

document.getElementById('placa').addEventListener('input', function() {
    this.value = this.value.toUpperCase().replace(/[^A-Z0-9]/g, '');
    if (this.value.length >= 3) {
        if (!validarFormatoPlaca(this.value)) { this.style.borderColor = '#ff9800'; this.title = 'Formato de placa no reconocido'; } 
        else { this.style.borderColor = '#4caf50'; this.title = 'Formato de placa válido'; }
    }
});

// Asignar eventos de cambio a todas las fechas
['fecha_vencimiento_soat', 'fecha_revision', 'doc_poliza_rcc', 'doc_poliza_todo_riesgo', 'doc_tarjeta_operacion'].forEach(id => {
    document.getElementById(id)?.addEventListener('change', () => validarVencimiento(id, 'Documento'));
});

document.getElementById('tipo_vehiculo').addEventListener('change', function() {
    const sugerencias = { 'Motocicleta': 'A2', 'Automóvil': 'B1', 'Camioneta': 'B1', 'Camión': 'C1', 'Volqueta': 'C1', 'Grúa': 'C1', 'Bus': 'B3' };
    if (sugerencias[this.value]) document.getElementById('categoria_licencia').value = sugerencias[this.value];
});

// ============================================
// INICIALIZACIÓN DE SIGNATURE PAD Y WINDOW LOAD
// ============================================
let signaturePad;

window.addEventListener('load', function() {
    document.getElementById('placa').focus();
    
    // CORRECCIÓN: Solo el aceite y la fecha de inspección no pueden ser del futuro
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('fecha_inspeccion').max = today;
    document.getElementById('fecha_cambio_aceite').max = today;
    
    validarTodasLasFechas();

    // INICIALIZAR EL CANVAS PARA LA FIRMA
    const canvas = document.getElementById('firma-pad');
    
    // Función para mantener la nitidez en pantallas móviles
    function resizeCanvas() {
        const ratio =  Math.max(window.devicePixelRatio || 1, 1);
        canvas.width = canvas.offsetWidth * ratio;
        canvas.height = canvas.offsetHeight * ratio;
        canvas.getContext("2d").scale(ratio, ratio);
        
        // Si ya había una firma antes de girar la pantalla, la limpiaremos para evitar deformaciones
        if(signaturePad) signaturePad.clear();
    }
    window.addEventListener("resize", resizeCanvas);
    resizeCanvas();

    // Configurar la tinta y el color
    signaturePad = new SignaturePad(canvas, {
        penColor: "rgb(0, 0, 128)", // Tinta azul
        backgroundColor: "rgb(255, 255, 255)"
    });

    // Acción del botón Limpiar Firma
    document.getElementById('btn-limpiar-firma').addEventListener('click', function () {
        signaturePad.clear();
    });

    // Al resetear todo el formulario, también limpiar la firma
    document.getElementById('resetBtn').addEventListener('click', function() {
        setTimeout(() => { signaturePad.clear(); }, 10);
    });
});

// Reloj en tiempo real
setInterval(() => {
    const ahora = new Date();
    const span = document.getElementById('fechaHoraActual');
    if (span) span.textContent = `${ahora.toLocaleDateString('es-ES')} - ${ahora.toLocaleTimeString('es-ES', {hour: '2-digit', minute:'2-digit'})}`;
}, 60000);

// ============================================
// MANEJO DE ENVÍO Y VALIDACIÓN FINAL
// ============================================
document.getElementById('inspeccionInicioForm').addEventListener('submit', function(e) {
    const placa = document.getElementById('placa').value.trim();
    if (!validarFormatoPlaca(placa)) { alert('❌ Formato de placa no válido.'); e.preventDefault(); return false; }
    
    const kmEntrada = parseFloat(document.getElementById('kilometraje_entrada').value) || 0;
    if (kmEntrada <= 0) { alert('❌ Debe ingresar un kilometraje de entrada válido'); e.preventDefault(); return false; }
    
    const camposObligatorios = ['empresa', 'nombre_conductor', 'licencia_conductor', 'categoria_licencia', 'vigencia_licencia', 'nombre_firma_conductor', 'cc_conductor'];
    for (const id of camposObligatorios) {
        const el = document.getElementById(id);
        if (!el || !el.value.trim()) { alert(`❌ Un campo obligatorio está vacío.`); el.focus(); e.preventDefault(); return false; }
    }
    
    if (!document.querySelector('input[name="aceptacion_conductor"]').checked) { alert('❌ Debe aceptar la declaración.'); e.preventDefault(); return false; }
    
    // --> VALIDAR QUE EL CONDUCTOR HAYA DIBUJADO SU FIRMA <--
    if (signaturePad.isEmpty()) {
        alert('⚠️ Atención: Es obligatorio dibujar su firma en el cuadro antes de enviar.');
        e.preventDefault();
        return false;
    } else {
        // Extraer la firma como texto Base64 y guardarla en el input oculto
        document.getElementById('firma_conductor_base64').value = signaturePad.toDataURL('image/png');
    }
    
    const submitBtn = document.getElementById('submitBtn');
    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> REGISTRANDO...';
    submitBtn.disabled = true;
    return true;
});
</script>

