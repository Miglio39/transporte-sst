<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title><%= title %> | OmegaGroup</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root { --surface-bg: #f8fafc; --omega-dark: #0f172a; --omega-red: #e50914; }
        body { background-color: var(--surface-bg); font-family: 'Segoe UI', sans-serif; padding-bottom: 50px; }
        .header-app { background: #f59e0b; color: #0f172a; padding: 15px 20px; border-bottom: 4px solid var(--omega-dark); }
        
        /* PLANOS 360 - GRÁFICO REALISTA */
        .blueprint-container { position: relative; width: 100%; max-width: 350px; height: 480px; margin: 0 auto 10px; background-color: #ffffff; border: 2px dashed #cbd5e1; border-radius: 12px; background-position: center; background-repeat: no-repeat; background-size: contain; display: none; }
        .blueprint-container.mapa-danos { border-color: #fca5a5; background-color: #fef2f2; cursor: crosshair; }
        
        #blueprint-carro-estado, #blueprint-carro-danos { background-image: url('data:image/svg+xml;base64,'); }
        #blueprint-maquina-estado, #blueprint-maquina-danos { background-image: url('data:image/svg+xml;base64,'); }
        
        /* BOTONES CALIENTES (HOTSPOTS) */
        .hotspot { position: absolute; width: 45px; height: 45px; background-color: rgba(15, 23, 42, 0.85); border: 3px solid white; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.1rem; cursor: pointer; transition: transform 0.2s; z-index: 10; animation: pulse-dark 2s infinite; }
        .hotspot.hs-llanta { width: 32px; height: 32px; font-size: 0.8rem; background-color: rgba(51, 65, 85, 0.9); border-color: #cbd5e1; animation: pulse-gray 2s infinite; }
        .hotspot.completed { background-color: #10b981; border-color: #dcfce7; color: white; animation: none !important; box-shadow: 0 4px 8px rgba(0,0,0,0.2); }
        
        /* PINES DINÁMICOS DE DAÑOS */
        .damage-pin { position: absolute; width: 28px; height: 28px; background-color: var(--omega-red); border: 2px solid white; border-radius: 50%; transform: translate(-50%, -50%); display: flex; align-items: center; justify-content: center; color: white; font-size: 12px; z-index: 20; pointer-events: none; animation: drop 0.3s ease-out, pulse-red 2s infinite 0.3s; }
        
        @keyframes drop { 0% { transform: translate(-50%, -200%); opacity: 0;} 100% { transform: translate(-50%, -50%); opacity: 1;} }
        @keyframes pulse-dark { 0% { box-shadow: 0 0 0 0 rgba(15, 23, 42, 0.7); } 70% { box-shadow: 0 0 0 15px rgba(15, 23, 42, 0); } 100% { box-shadow: 0 0 0 0 rgba(15, 23, 42, 0); } }
        @keyframes pulse-gray { 0% { box-shadow: 0 0 0 0 rgba(51, 65, 85, 0.7); } 70% { box-shadow: 0 0 0 10px rgba(51, 65, 85, 0); } 100% { box-shadow: 0 0 0 0 rgba(51, 65, 85, 0); } }
        @keyframes pulse-red { 0% { box-shadow: 0 0 0 0 rgba(229, 9, 20, 0.7); } 70% { box-shadow: 0 0 0 15px rgba(229, 9, 20, 0); } 100% { box-shadow: 0 0 0 0 rgba(229, 9, 20, 0); } }

        /* COORDENADAS CARROCERÍA ESTADO */
        .hs-frente { top: 6%; left: 50%; transform: translateX(-50%); } 
        .hs-atras { bottom: 6%; left: 50%; transform: translateX(-50%); } 
        .hs-izq { top: 50%; left: 16%; transform: translateY(-50%); } 
        .hs-der { top: 50%; right: 16%; transform: translateY(-50%); } 
        .hs-techo { top: 50%; left: 50%; transform: translate(-50%, -50%); }
        .hs-llanta-di { top: 26%; left: 20%; transform: translate(-50%, -50%); }
        .hs-llanta-dd { top: 26%; right: 20%; transform: translate(50%, -50%); }
        .hs-llanta-ti { bottom: 24%; left: 20%; transform: translate(-50%, 50%); }
        .hs-llanta-td { bottom: 24%; right: 20%; transform: translate(50%, 50%); }

        /* COORDENADAS MÁQUINA ESTADO */
        .hs-pala { top: 5%; left: 50%; transform: translateX(-50%); } 
        .hs-motor { bottom: 5%; left: 50%; transform: translateX(-50%); } 
        .hs-oruga-izq { top: 50%; left: 2%; transform: translateY(-50%); } 
        .hs-oruga-der { top: 50%; right: 2%; transform: translateY(-50%); } 
        .hs-cabina { top: 45%; left: 50%; transform: translate(-50%, -50%); }

        /* MEDIDOR DE COMBUSTIBLE 5 RAYITAS */
        .fuel-gauge { display: flex; gap: 4px; width: 100%; height: 32px; }
        .fuel-gauge input[type="radio"] { display: none; }
        .fuel-gauge label { flex: 1; border: 1px solid #cbd5e1; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-size: 0.75rem; font-weight: bold; color: #64748b; cursor: pointer; transition: 0.2s; background: #f8fafc; margin: 0; }
        
        .fuel-gauge input:checked + .fuel-e { background: #ef4444; color: white; border-color: #ef4444; }
        .fuel-gauge input:checked + .fuel-q { background: #f97316; color: white; border-color: #f97316; }
        .fuel-gauge input:checked + .fuel-h { background: #eab308; color: white; border-color: #eab308; }
        .fuel-gauge input:checked + .fuel-t { background: #84cc16; color: white; border-color: #84cc16; }
        .fuel-gauge input:checked + .fuel-f { background: #10b981; color: white; border-color: #10b981; }

        /* CHECKLIST Y OTROS */
        .btn-check-custom + label { background-color: #f1f5f9; color: #64748b; border: 1px solid #cbd5e1; border-radius: 6px; padding: 10px; width: 100%; font-size: 0.85rem; font-weight: bold; text-align: center; cursor: pointer; transition: all 0.2s; }
        .btn-check-custom:checked[value="B"] + label, .btn-check-custom:checked[value="BUENO"] + label { background-color: #dcfce7; color: #166534; border-color: #166534; }
        .btn-check-custom:checked[value="M"] + label, .btn-check-custom:checked[value="MALO"] + label { background-color: #fee2e2; color: #991b1b; border-color: #991b1b; }
        .btn-check-custom:checked[value="N/A"] + label { background-color: #fef3c7; color: #92400e; border-color: #92400e; }
        
        .section-title { font-size: 1.1rem; font-weight: 800; color: var(--omega-dark); border-bottom: 2px solid var(--omega-red); padding-bottom: 5px; margin-top: 30px; margin-bottom: 15px; }
        .accordion-button { font-weight: 700; color: var(--omega-dark); background-color: white; }
        .accordion-button:not(.collapsed) { background-color: #f8fafc; color: var(--omega-red); }

        #foto-preview-container { display: none; width: 100%; height: 200px; background: #e2e8f0; border-radius: 8px; overflow: hidden; margin-bottom: 15px; position: relative; }
        #foto-preview { width: 100%; height: 100%; object-fit: cover; }
        
        /* CANVAS DE FIRMAS */
        canvas.firma { border: 2px dashed #cbd5e1; border-radius: 8px; width: 100%; height: 250px; background: #ffffff; cursor: crosshair; touch-action: none; }
        
        .btn-magico { background-color: #d4edda; color: #155724; border: 2px solid #27ae60; padding: 10px; border-radius: 8px; font-weight: bold; width: 100%; margin-bottom: 15px; transition: 0.2s; }
        .btn-magico-sm { background-color: #e2e8f0; color: #334155; border: 1px solid #cbd5e1; padding: 6px 12px; border-radius: 6px; font-size: 0.8rem; font-weight: bold; width: 100%; margin-bottom: 15px; }
    </style>
</head>
<body>

    <div class="header-app d-flex justify-content-between align-items-center mb-4 shadow-sm">
        <h5 class="mb-0 fw-bold"><i class="fas fa-edit me-2"></i> Editar Auditoría de Patio</h5>
        <a href="/admin/patio/historial" class="btn btn-sm btn-outline-dark"><i class="fas fa-arrow-left"></i> Volver</a>
    </div>

    <div class="container" style="max-width: 650px;">
        <form id="form-patio" action="/admin/patio/editar/<%= registro.id %>" method="POST">
            
            <!-- DATOS INICIALES (Compartidos) -->
            <div class="card shadow-sm border-0 mb-4 bg-warning bg-opacity-10">
                <div class="card-body row g-3">
                    <div class="col-12">
                        <label class="form-label fw-bold text-muted small">TIPO DE EQUIPO</label>
                        <select id="selectorTipoEquipo" class="form-select border-secondary fw-bold" onchange="cambiarVistaPrincipal()">
                            <option value="CARRO">Vehículo Ligero (Carro / Camioneta)</option>
                            <option value="MAQUINA">Maquinaria Pesada / Especial</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-bold text-muted small">PLACA / ID</label>
                        <input name="placa" class="form-control fw-bold" value="<%= registro.vehiculo_placa %>" required autocomplete="off" style="text-transform: uppercase;">
                    </div>
                    <div class="col-6" id="div-movimiento">
                        <label class="form-label fw-bold text-muted small">MOVIMIENTO</label>
                        <select name="tipo_movimiento" class="form-select border-secondary" required>
                            <option value="SALIDA" <%= registro.tipo_movimiento === 'SALIDA' ? 'selected' : '' %>>Salida a Operación</option>
                            <option value="ENTRADA" <%= registro.tipo_movimiento === 'ENTRADA' ? 'selected' : '' %>>Llegada a Patio</option>
                        </select>
                    </div>

                    <!-- ============================================== -->
                    <!-- CAMPOS EXCLUSIVOS DE CARROS (EDITAR)           -->
                    <!-- ============================================== -->
                    <div class="col-12" id="div-datos-carro">
                        <div class="row g-3 mt-1 border-top border-warning pt-2">
                            <div class="col-6">
                                <label class="form-label fw-bold text-primary small"><i class="fas fa-tachometer-alt me-1"></i> ODÓMETRO (KM)</label>
                                <input type="number" id="kilometraje_patio" class="form-control form-control-sm border-primary" placeholder="Ej: 125000" step="1">
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold text-success small"><i class="fas fa-gas-pump me-1"></i> COMBUSTIBLE</label>
                                <div class="fuel-gauge">
                                    <input type="radio" name="nivel_combustible" id="fuel_0" value="Vacío"><label for="fuel_0" class="fuel-e" title="Vacío">E</label>
                                    <input type="radio" name="nivel_combustible" id="fuel_1" value="1/4"><label for="fuel_1" class="fuel-q" title="Un Cuarto">¼</label>
                                    <input type="radio" name="nivel_combustible" id="fuel_2" value="1/2"><label for="fuel_2" class="fuel-h" title="Medio">½</label>
                                    <input type="radio" name="nivel_combustible" id="fuel_3" value="3/4"><label for="fuel_3" class="fuel-t" title="Tres Cuartos">¾</label>
                                    <input type="radio" name="nivel_combustible" id="fuel_4" value="Lleno"><label for="fuel_4" class="fuel-f" title="Lleno">F</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ============================================== -->
                    <!-- CAMPOS EXCLUSIVOS DE MÁQUINAS (EDITAR)         -->
                    <!-- ============================================== -->
                    <div class="col-12" id="div-mantenimientos" style="display: none;">
                        <div class="row g-3 mt-1 border-top border-warning pt-2">
                            <div class="col-6">
                                <label class="form-label fw-bold text-info small"><i class="fas fa-wrench me-1"></i> ÚLTIMO MANT.</label>
                                <input type="date" id="ultimo_mantenimiento" class="form-control form-control-sm border-info">
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold text-warning small"><i class="fas fa-stopwatch me-1"></i> HORÓMETRO</label>
                                <input type="number" id="horometro" class="form-control form-control-sm border-warning" placeholder="Ej: 4500.5" step="0.1">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- VISTA EXCLUSIVA: VEHÍCULO LIGERO (CARRO)   -->
            <!-- ========================================== -->
            <div id="vista-carro">
                <h4 class="section-title"><i class="fas fa-camera text-primary me-2"></i> 1. Registro Fotográfico (Estado Actual)</h4>
                <p class="text-muted small mb-3">Toque los puntos para actualizar las fotografías de rutina del equipo y sus llantas.</p>
                
                <div id="blueprint-carro-estado" class="blueprint-container" style="display: block;">
                    <div class="hotspot hs-frente" onclick="abrirCamara('Frente / Capó')" title="Frente"><i class="fas fa-car"></i></div>
                    <div class="hotspot hs-atras" onclick="abrirCamara('Atrás / Baúl')" title="Atrás"><i class="fas fa-car-side fa-flip-horizontal"></i></div>
                    <div class="hotspot hs-izq" onclick="abrirCamara('Lateral Izquierdo')" title="Lateral Izquierdo"><i class="fas fa-car-side"></i></div>
                    <div class="hotspot hs-der" onclick="abrirCamara('Lateral Derecho')" title="Lateral Derecho"><i class="fas fa-car-side fa-flip-horizontal"></i></div>
                    <div class="hotspot hs-techo" onclick="abrirCamara('Interior / Techo')" title="Interior"><i class="fas fa-couch"></i></div>
                    
                    <div class="hotspot hs-llanta hs-llanta-di" onclick="abrirCamara('Llanta Delantera Izquierda')" title="Llanta Del. Izq."><i class="fas fa-ring"></i></div>
                    <div class="hotspot hs-llanta hs-llanta-dd" onclick="abrirCamara('Llanta Delantera Derecha')" title="Llanta Del. Der."><i class="fas fa-ring"></i></div>
                    <div class="hotspot hs-llanta hs-llanta-ti" onclick="abrirCamara('Llanta Trasera Izquierda')" title="Llanta Tras. Izq."><i class="fas fa-ring"></i></div>
                    <div class="hotspot hs-llanta hs-llanta-td" onclick="abrirCamara('Llanta Trasera Derecha')" title="Llanta Tras. Der."><i class="fas fa-ring"></i></div>
                </div>

                <h4 class="section-title"><i class="fas fa-car-crash text-danger me-2"></i> 2. Registro de Daños y Novedades</h4>
                <p class="text-muted small mb-3">Los daños registrados anteriormente aparecerán en el mapa.</p>
                <div id="blueprint-carro-danos" class="blueprint-container mapa-danos" onclick="iniciarCapturaDano(event, 'blueprint-carro-danos')" style="display: block;"></div>

                <h4 class="section-title"><i class="fas fa-clipboard-list text-primary me-2"></i> 3. Inspección Preoperacional</h4>
                <div class="card shadow-sm border-0 mb-4 bg-white">
                    <div class="card-body p-3">
                        <button type="button" class="btn-magico" onclick="marcarTodosBuenoPreop()"><i class="fas fa-magic"></i> Marcar todos los ítems como Bueno</button>
                        <% 
                        const catPreop = {
                            "Documentación Legal": ["SOAT vigente", "Revisión Técnico Mecánica", "Tarjeta de Propiedad", "Póliza RCC y RCE", "Póliza Todo Riesgo", "Tarjeta de Operación"],
                            "Niveles": ["Líquido refrigerante de radiador", "Líquido de frenos", "Aceite motor", "Nivel líquido hidráulico", "Agua de limpiavidrios"],
                            "Pedales": ["Acelerador (Uniformidad)", "Clutch (Cloche o embrague)", "Freno (Agarre)"],
                            "Luces": ["Luces (Altas, medias, bajas)", "Direccionales", "Estacionarias", "Stops (Frenos)", "Testigos del tablero", "Luz de reversa", "Luces internas"],
                            "Varios (Estado General)": ["Llantas (Labrado 2 mm y aire)", "Batería (Borner, sin corrosión)", "Rines (sin golpes/fisuras)", "Cinturón de seguridad en todos los puestos", "Pito reversa (Vehículos operativos)", "Pito", "Freno de emergencia", "Espejos laterales y cabina (sin fisuras)", "Estado carcasa luces", "Plumillas/limpiabrisas (no dejan marcas)", "Tapizado", "Panorámico (sin fisuras)", "Estado del Radiotelefono", "Aire Acondicionado", "Vidrios Laterales", "Vidrio Trasero", "Tercer Stop"]
                        };
                        for(let cat in catPreop) { %>
                            <div class="mb-4">
                                <h6 class="fw-bold text-dark bg-light p-2 rounded"><%= cat %></h6>
                                <% catPreop[cat].forEach(item => { 
                                    let idName = item.replace(/\s+/g, '_').replace(/[^a-zA-Z0-9_]/g, ''); 
                                    let requiereFecha = (cat === "Documentación Legal" && item !== "Tarjeta de Propiedad");
                                %>
                                    <div class="mb-3 border-bottom pb-2">
                                        <p class="mb-1 small fw-bold text-muted"><%= item %></p>
                                        <div class="d-flex gap-1 mb-2">
                                            <div class="flex-grow-1"><input type="radio" name="<%= idName %>" id="P_<%= idName %>_B" value="BUENO" class="d-none btn-check-custom chk-preop"><label for="P_<%= idName %>_B">Bueno</label></div>
                                            <div class="flex-grow-1"><input type="radio" name="<%= idName %>" id="P_<%= idName %>_M" value="MALO" class="d-none btn-check-custom chk-preop"><label for="P_<%= idName %>_M">Malo</label></div>
                                            <div class="flex-grow-1"><input type="radio" name="<%= idName %>" id="P_<%= idName %>_N" value="N/A" class="d-none btn-check-custom chk-preop"><label for="P_<%= idName %>_N">N/A</label></div>
                                        </div>
                                        <% if (requiereFecha) { %><div class="input-group input-group-sm mb-2"><span class="input-group-text bg-warning text-dark fw-bold" style="font-size: 0.75rem;"><i class="fas fa-calendar-alt me-1"></i> Vence:</span><input type="date" id="vence_P_<%= idName %>" class="form-control form-control-sm"></div><% } %>
                                        <input type="text" id="obs_P_<%= idName %>" class="form-control form-control-sm bg-light" placeholder="Observación (opcional)...">
                                    </div>
                                <% }) %>
                            </div>
                        <% } %>
                    </div>
                </div>

                <h4 class="section-title"><i class="fas fa-toolbox text-success me-2"></i> 4. Equipos y Emergencias</h4>
                <div class="accordion shadow-sm border-0 mb-4" id="acordeonEquipos">
                    <% 
                    const catEquipos = {
                        "Botiquín": { icono: "fa-medkit", color: "text-danger", prefijo: "BOT", agrupado: true, grupos: {
                                "Material de Curación": [{ nombre: "Micropore de 2\"", cant: "1 Unid" }, { nombre: "Parche Ocular", cant: "1 Unid." }, { nombre: "Aplicadores de Algodón", cant: "1 Paq X 10" }, { nombre: "Curitas", cant: "Paq x 10" }, { nombre: "Toallas antisepticas", cant: "2 Unid." }, { nombre: "Esparadrapo de tela", cant: "1 Unid." }, { nombre: "Compresas", cant: "2 Unid." }, { nombre: "Gasa estéril (7,5x7,5)", cant: "3 Paquetes" }, { nombre: "Bajalenguas", cant: "1 Paq X 20" }],
                                "Inmovilizadores": [{ nombre: "Inmovilizador cervical", cant: "1 Unid" }, { nombre: "Inmovilizadores 4 miembros", cant: "1 Unid" }, { nombre: "Vendas elasticas 4x5 yd", cant: "2 Unid." }, { nombre: "Vendas elastica 3x5 yd", cant: "2 Unid" }, { nombre: "Venda triangular", cant: "6 Unid" }],
                                "Antisépticos": [{ nombre: "Isodine solución", cant: "1 Frasco" }, { nombre: "Isodine espuma 120 ml", cant: "1 Frasco" }, { nombre: "Cloruro de sodio", cant: "1 Botella" }],
                                "Instrumental y Otros": [{ nombre: "Tapabocas", cant: "2 Unid" }, { nombre: "Guantes de latex", cant: "3 Unid" }, { nombre: "Termometro digital", cant: "1 Unid." }, { nombre: "Mascara RCP", cant: "1 Unid" }, { nombre: "Esfero", cant: "1 Unid" }, { nombre: "Pito", cant: "1 Unid" }, { nombre: "Libreta de notas", cant: "1 Unid" }, { nombre: "Linterna Recargable", cant: "1 Unid" }, { nombre: "Tijeras Punta Roma", cant: "1 Unid." }, { nombre: "Manual de Primeros Auxilios", cant: "1 Unid." }]
                            }
                        },
                        "Kit de Carreteras": { icono: "fa-wrench", color: "text-secondary", prefijo: "CAR", agrupado: false, items: [{ nombre: "Conos reflectivos 50/70cm", cant: "2 UNID" }, { nombre: "Tacos para llantas (Madera)", cant: "2 UNID" }, { nombre: "Gato con vástago", cant: "1 UNID" }, { nombre: "Palanca", cant: "1 UNID" }, { nombre: "Llave expansiva", cant: "1 UNID" }, { nombre: "Destornillador de pala", cant: "1 UNID" }, { nombre: "Llave pernos ruedas (Copa)", cant: "1 UNID" }, { nombre: "Juego de llaves fijas", cant: "1 UNID" }, { nombre: "Destornillador de estrella", cant: "1 UNID" }, { nombre: "Alicate", cant: "1 UNID" }, { nombre: "Llanta de repuesto", cant: "1 UNID" }, { nombre: "Linterna", cant: "1 UNID" }, { nombre: "Chaleco reflectivo", cant: "1 UNID" }, { nombre: "Calibrador de presión aire", cant: "1 UND" }, { nombre: "Cables de inicio", cant: "1 UND" }] },
                        "Kit Ambiental": { icono: "fa-leaf", color: "text-success", prefijo: "AMB", agrupado: false, items: [{ nombre: "Tela oleofílica", cant: "3 MTS" }, { nombre: "Barrera oleofílica 5x10", cant: "1" }, { nombre: "Encapsulador / Absorbente", cant: "5 KILOS" }, { nombre: "Desengrasante biodegradable", cant: "1 GALON" }, { nombre: "Cinta de peligro", cant: "1 ROLLO" }, { nombre: "Manila 10mts", cant: "10 MTS" }, { nombre: "Pala antichispa", cant: "1" }, { nombre: "Martillo de caucho", cant: "1" }, { nombre: "Linterna antichispa", cant: "1" }, { nombre: "Caneca plástica", cant: "1" }, { nombre: "Masilla epóxica", cant: "1" }, { nombre: "Bolsas de propileno", cant: "3 C/U" }, { nombre: "Lonas de polipropileno", cant: "3" }, { nombre: "Hipoclorito de sodio", cant: "2 KILOS" }, { nombre: "Chaleco reflectivo", cant: "1" }, { nombre: "Geomembrana / Plástico", cant: "1" }, { nombre: "Estacas de madera", cant: "1 PAQ" }, { nombre: "Paleta de PARE", cant: "1" }, { nombre: "Guantes de nitrilo largos", cant: "1 PAR" }, { nombre: "Guantes de vaqueta", cant: "1 PAR" }, { nombre: "Mascarilla gases/vapores", cant: "1" }, { nombre: "Monogafas", cant: "1" }, { nombre: "Tayvet (Overol)", cant: "1" }] }
                    };
                    
                    for(let cat in catEquipos) { 
                        const info = catEquipos[cat]; const idCont = "acc_" + info.prefijo;
                    %>
                        <div class="accordion-item" id="<%= idCont %>">
                            <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#col_<%= idCont %>"><i class="fas <%= info.icono %> <%= info.color %> me-2 fs-5"></i> <%= cat %></button></h2>
                            <div id="col_<%= idCont %>" class="accordion-collapse collapse" data-bs-parent="#acordeonEquipos">
                                <div class="accordion-body bg-light">
                                    <button type="button" class="btn btn-outline-primary w-100 mb-2 py-2 fw-bold" id="btn-foto-<%= info.prefijo %>" onclick="abrirCamara('Foto <%= cat %>')"><i class="fas fa-camera me-2"></i> Adjuntar Fotografía del <%= cat %></button>
                                    <button type="button" class="btn-magico-sm" onclick="marcarGrupoEquipos('<%= idCont %>')"><i class="fas fa-check-double"></i> Marcar todo como Bueno</button>
                                    <% if (info.agrupado) { %>
                                        <% for(let grupo in info.grupos) { %>
                                            <div class="mt-4 mb-2 p-2 bg-dark text-white rounded small fw-bold text-uppercase"><i class="fas fa-layer-group me-2"></i><%= grupo %></div>
                                            <% info.grupos[grupo].forEach(itemObj => { let nombre = itemObj.nombre; let cant = itemObj.cant; let idName = info.prefijo + '_' + nombre.replace(/\s+/g, '_').replace(/[^a-zA-Z0-9_]/g, ''); %>
                                                <div class="mb-3 p-2 border rounded bg-white shadow-sm">
                                                    <div class="d-flex justify-content-between align-items-center mb-2"><p class="mb-0 small fw-bold text-dark w-50" style="line-height: 1.2;"><%= nombre %></p><div class="input-group input-group-sm w-50"><span class="input-group-text bg-light text-muted" style="font-size: 0.7rem;">Cant.</span><input type="text" class="form-control text-center fw-bold input-cantidad" data-item="<%= nombre %>" value="<%= cant %>"></div></div>
                                                    <div class="d-flex gap-1 mb-2">
                                                        <div class="flex-grow-1"><input type="radio" name="<%= idName %>_estado" id="<%= idName %>_B" value="B" class="d-none btn-check-custom chk-equipo" data-categoria="<%= cat %>" data-item="<%= nombre %>"><label for="<%= idName %>_B">Bueno</label></div>
                                                        <div class="flex-grow-1"><input type="radio" name="<%= idName %>_estado" id="<%= idName %>_M" value="M" class="d-none btn-check-custom chk-equipo" data-categoria="<%= cat %>" data-item="<%= nombre %>"><label for="<%= idName %>_M">Malo</label></div>
                                                        <div class="flex-grow-1"><input type="radio" name="<%= idName %>_estado" id="<%= idName %>_NA" value="N/A" class="d-none btn-check-custom chk-equipo" data-categoria="<%= cat %>" data-item="<%= nombre %>"><label for="<%= idName %>_NA">N/A</label></div>
                                                    </div>
                                                    <div class="input-group input-group-sm"><span class="input-group-text bg-light text-muted" style="font-size: 0.75rem;">Vence:</span><input type="date" name="<%= idName %>_vence" class="form-control input-vencimiento" data-item="<%= nombre %>"></div>
                                                </div>
                                            <% }) %>
                                        <% } %>
                                    <% } else { %>
                                        <% info.items.forEach(itemObj => { let nombre = itemObj.nombre; let cant = itemObj.cant; let idName = info.prefijo + '_' + nombre.replace(/\s+/g, '_').replace(/[^a-zA-Z0-9_]/g, ''); %>
                                            <div class="mb-3 p-2 border rounded bg-white shadow-sm">
                                                <div class="d-flex justify-content-between align-items-center mb-2"><p class="mb-0 small fw-bold text-dark w-50" style="line-height: 1.2;"><%= nombre %></p><div class="input-group input-group-sm w-50"><span class="input-group-text bg-light text-muted" style="font-size: 0.7rem;">Cant.</span><input type="text" class="form-control text-center fw-bold input-cantidad" data-item="<%= nombre %>" value="<%= cant %>"></div></div>
                                                <div class="d-flex gap-1">
                                                    <div class="flex-grow-1"><input type="radio" name="<%= idName %>" id="<%= idName %>_B" value="B" class="d-none btn-check-custom chk-equipo" data-categoria="<%= cat %>" data-item="<%= nombre %>"><label for="<%= idName %>_B">Bueno</label></div>
                                                    <div class="flex-grow-1"><input type="radio" name="<%= idName %>" id="<%= idName %>_M" value="M" class="d-none btn-check-custom chk-equipo" data-categoria="<%= cat %>" data-item="<%= nombre %>"><label for="<%= idName %>_M">Malo</label></div>
                                                    <div class="flex-grow-1"><input type="radio" name="<%= idName %>" id="<%= idName %>_NA" value="N/A" class="d-none btn-check-custom chk-equipo" data-categoria="<%= cat %>" data-item="<%= nombre %>"><label for="<%= idName %>_NA">N/A</label></div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                    
                    <div class="accordion-item" id="acc_EXT">
                        <h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#col_extintor"><i class="fas fa-fire-extinguisher text-danger me-2 fs-5"></i> Inspección de Extintor</button></h2>
                        <div id="col_extintor" class="accordion-collapse collapse" data-bs-parent="#acordeonEquipos">
                            <div class="accordion-body bg-light">
                                <button type="button" class="btn btn-outline-primary w-100 mb-3 py-2 fw-bold" id="btn-foto-EXT" onclick="abrirCamara('Foto Extintor')"><i class="fas fa-camera me-2"></i> Adjuntar Fotografía del Extintor</button>
                                <div class="row g-2 mb-3"><div class="col-6"><label class="form-label small fw-bold text-muted">Capacidad</label><input type="text" id="extintor_capacidad" class="form-control" placeholder="Ej: 10 Libras"></div><div class="col-6"><label class="form-label small fw-bold text-muted">Clase de Fuego</label><input type="text" id="extintor_clase" class="form-control" placeholder="Ej: ABC / CO2"></div><div class="col-6"><label class="form-label small fw-bold text-muted">Fecha Recarga</label><input type="date" id="extintor_f_recarga" class="form-control"></div><div class="col-6"><label class="form-label small fw-bold text-muted">Vencimiento</label><input type="date" id="extintor_f_vencimiento" class="form-control"></div></div>
                                <div class="mt-4 mb-2 p-2 bg-dark text-white rounded small fw-bold text-uppercase"><i class="fas fa-list-check me-2"></i>Estado Componentes</div>
                                <button type="button" class="btn-magico-sm" onclick="marcarGrupoEquipos('acc_EXT')"><i class="fas fa-check-double"></i> Marcar componentes Bueno</button>
                                <% const itemsExtintor = ["Cilindro (Sin abolladuras/corrosión)", "Manómetro (Presión verde)", "Manguera/Corneta", "Pasador de seguridad", "Sello de seguridad", "Pintura general", "Etiquetas legibles", "Soporte instalación"];
                                itemsExtintor.forEach(item => { let idName = 'EXT_' + item.replace(/\s+/g, '_').replace(/[^a-zA-Z0-9_]/g, ''); %>
                                    <div class="mb-2 p-2 border rounded bg-white shadow-sm"><p class="mb-2 small fw-bold text-dark"><%= item %></p><div class="d-flex gap-1"><div class="flex-grow-1"><input type="radio" name="<%= idName %>" id="<%= idName %>_B" value="B" class="d-none btn-check-custom chk-equipo" data-categoria="Extintor" data-item="<%= item %>"><label for="<%= idName %>_B">Bueno</label></div><div class="flex-grow-1"><input type="radio" name="<%= idName %>" id="<%= idName %>_M" value="M" class="d-none btn-check-custom chk-equipo" data-categoria="Extintor" data-item="<%= item %>"><label for="<%= idName %>_M">Malo</label></div><div class="flex-grow-1"><input type="radio" name="<%= idName %>" id="<%= idName %>_NA" value="N/A" class="d-none btn-check-custom chk-equipo" data-categoria="Extintor" data-item="<%= item %>"><label for="<%= idName %>_NA">N/A</label></div></div></div>
                                <% }) %>
                            </div>
                        </div>
                    </div>
                </div>
            </div> <!-- FIN VISTA CARRO -->

            <!-- ========================================== -->
            <!-- VISTA EXCLUSIVA: MAQUINARIA PESADA         -->
            <!-- ========================================== -->
            <div id="vista-maquina" style="display: none;">
                <h4 class="section-title"><i class="fas fa-camera text-primary me-2"></i> Registro Fotográfico de Accesorios</h4>
                <div id="blueprint-maquina-estado" class="blueprint-container" style="display: block;">
                    <div class="hotspot hs-pala" onclick="abrirCamara('Herramienta Frontal / Pala')" title="Pala"><i class="fas fa-snowplow"></i></div>
                    <div class="hotspot hs-motor" onclick="abrirCamara('Motor y Bombas')" title="Motor"><i class="fas fa-cogs"></i></div>
                    <div class="hotspot hs-oruga-izq" onclick="abrirCamara('Tren de Rodaje Izquierdo')" title="Oruga Izq"><i class="fas fa-truck-monster"></i></div>
                    <div class="hotspot hs-oruga-der" onclick="abrirCamara('Tren de Rodaje Derecho')" title="Oruga Der"><i class="fas fa-truck-monster"></i></div>
                    <div class="hotspot hs-cabina" onclick="abrirCamara('Cabina y Controles')" title="Cabina"><i class="fas fa-user-shield"></i></div>
                </div>

                <h4 class="section-title"><i class="fas fa-exclamation-triangle text-danger me-2"></i> Novedades y Daños</h4>
                <div id="blueprint-maquina-danos" class="blueprint-container mapa-danos" onclick="iniciarCapturaDano(event, 'blueprint-maquina-danos')" style="display: block;"></div>
                
                <button type="button" class="btn btn-outline-primary w-100 mb-4 py-2 fw-bold" onclick="abrirCamara('Accesorio Adicional / Novedad')">
                    <i class="fas fa-plus-circle me-2"></i> Fotografía de Accesorio Adicional
                </button>
