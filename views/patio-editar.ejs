            <div class="card shadow-sm border-0 mb-4">
                <div class="card-body p-3">
                    <textarea id="observaciones_generales" class="form-control bg-light" rows="4" placeholder="Registre cualquier observación adicional..."></textarea>
                </div>
            </div>

            <!-- FIRMAS DE ENTREGA Y RECIBE CON MURO DE PROTECCIÓN -->
            <h4 class="section-title"><i class="fas fa-file-signature text-secondary me-2"></i> Firmas de Conformidad</h4>
            <p class="text-muted small mb-3">Las firmas originales están protegidas para evitar que se borren por error. Si necesita corregir alguna, pulse "Cambiar Firma".</p>

            <div class="row g-3 mb-4">
                <div class="col-md-6 col-12">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body text-center">
                            <label class="form-label fw-bold text-muted small"><i class="fas fa-user"></i> Nombre de quien ENTREGA</label>
                            <input type="text" id="nombre_entrega" class="form-control form-control-sm mb-3 text-center fw-bold" placeholder="Nombre completo" required>
                            
                            <label class="form-label fw-bold text-muted small"><i class="fas fa-signature"></i> Firma de quien ENTREGA</label>
                            
                            <!-- MURO DE PROTECCIÓN: Muestra la firma guardada -->
                            <div id="muro_entrega">
                                <img id="img_entrega" src="" style="max-height: 120px; margin: 0 auto 10px auto; display: none; border-bottom: 2px solid #cbd5e1;">
                                <button type="button" class="btn btn-sm btn-outline-danger w-100 fw-bold" onclick="habilitarFirma('entrega')">
                                    <i class="fas fa-eraser"></i> Cambiar Firma
                                </button>
                            </div>

                            <!-- LIENZO DE DIBUJO OCULTO -->
                            <div id="caja_entrega" style="display: none;">
                                <canvas id="firmaEntregaCanvas" class="firma"></canvas>
                                <button type="button" class="btn btn-sm btn-light w-100 mt-2 text-danger fw-bold" onclick="limpiarFirmaCanvas('entrega')">Borrar trazo</button>
                                <button type="button" class="btn btn-sm btn-light w-100 mt-1 text-secondary fw-bold" onclick="cancelarFirma('entrega')">Cancelar cambio</button>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-md-6 col-12">
                    <div class="card shadow-sm border-0 h-100">
                        <div class="card-body text-center">
                            <label class="form-label fw-bold text-muted small"><i class="fas fa-user"></i> Nombre de quien RECIBE</label>
                            <input type="text" id="nombre_recibe" class="form-control form-control-sm mb-3 text-center fw-bold" placeholder="Nombre completo" required>
                            
                            <label class="form-label fw-bold text-muted small"><i class="fas fa-signature"></i> Firma de quien RECIBE</label>
                            
                            <!-- MURO DE PROTECCIÓN: Muestra la firma guardada -->
                            <div id="muro_recibe">
                                <img id="img_recibe" src="" style="max-height: 120px; margin: 0 auto 10px auto; display: none; border-bottom: 2px solid #cbd5e1;">
                                <button type="button" class="btn btn-sm btn-outline-danger w-100 fw-bold" onclick="habilitarFirma('recibe')">
                                    <i class="fas fa-eraser"></i> Cambiar Firma
                                </button>
                            </div>

                            <!-- LIENZO DE DIBUJO OCULTO -->
                            <div id="caja_recibe" style="display: none;">
                                <canvas id="firmaRecibeCanvas" class="firma"></canvas>
                                <button type="button" class="btn btn-sm btn-light w-100 mt-2 text-danger fw-bold" onclick="limpiarFirmaCanvas('recibe')">Borrar trazo</button>
                                <button type="button" class="btn btn-sm btn-light w-100 mt-1 text-secondary fw-bold" onclick="cancelarFirma('recibe')">Cancelar cambio</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <input type="hidden" name="evidenciasJSON" id="evidenciasJSON" value="{}">
            <!-- Hidden original por compatibilidad con la BD -->
            <input type="hidden" name="firmaBase64" id="firmaBase64" required>

            <button type="button" onclick="enviarFormulario()" class="btn btn-lg w-100 text-white fw-bold shadow mb-4" style="background-color: #059669;">
                <i class="fas fa-save me-2"></i> GUARDAR CAMBIOS
            </button>
        </form>
    </div>

    <!-- MODAL DE CÁMARA (MULTIUSO) -->
    <div class="modal fade" id="modalCamara" tabindex="-1" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h6 class="modal-title fw-bold" id="modalTitulo"><i class="fas fa-camera"></i> Evidencia</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="d-grid mb-3">
                        <input type="file" id="fotoInput" accept="image/*" capture="environment" class="d-none" onchange="comprimirYProcesarFoto(this)">
                        <button type="button" class="btn btn-danger btn-lg py-4 fw-bold shadow-sm" onclick="document.getElementById('fotoInput').click()">
                            <i class="fas fa-camera fs-1 mb-2 d-block"></i> TOMAR FOTOGRAFÍA
                        </button>
                    </div>
                    <div id="foto-preview-container">
                        <img id="foto-preview" src="">
                        <button type="button" class="btn btn-sm btn-dark position-absolute top-0 end-0 m-2" onclick="document.getElementById('fotoInput').click()"><i class="fas fa-sync"></i> Cambiar</button>
                    </div>
                    <div class="mt-3">
                        <label class="form-label fw-bold text-muted small">Novedad / Observación de la foto</label>
                        <textarea id="comentarioInput" class="form-control" rows="2" placeholder="Escriba aquí..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-success fw-bold px-4" onclick="guardarEvidencia()">Guardar <i class="fas fa-check"></i></button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.0.0/dist/signature_pad.umd.min.js"></script>
    
    <script>
        let evidenciasAlmacenadas = <%- JSON.stringify(datos || {}) %>;
        if (!evidenciasAlmacenadas.rutina) evidenciasAlmacenadas.rutina = {};
        if (!evidenciasAlmacenadas.equipos) evidenciasAlmacenadas.equipos = {};
        if (!evidenciasAlmacenadas.danos) evidenciasAlmacenadas.danos = [];

        // VARIABLES DEL MURO DE FIRMAS
        let firmaEntregaGuardada = '';
        let firmaRecibeGuardada = '';
        let editandoEntrega = false;
        let editandoRecibe = false;

        window.addEventListener('DOMContentLoaded', () => {
            const esMaquina = !!evidenciasAlmacenadas.datos_mantenimiento;
            document.getElementById('selectorTipoEquipo').value = esMaquina ? 'MAQUINA' : 'CARRO';
            cambiarVistaPrincipal();

            // Rellenar Mantenimiento / Horómetro
            if (esMaquina && evidenciasAlmacenadas.datos_mantenimiento) {
                const mant = evidenciasAlmacenadas.datos_mantenimiento;
                if(mant.ultimo_mantenimiento !== 'No registrado') document.getElementById('ultimo_mantenimiento').value = mant.ultimo_mantenimiento;
                if(mant.horometro !== 'No registrado') document.getElementById('horometro').value = mant.horometro;
            }

            // Rellenar Odómetro / Combustible
            if (!esMaquina && evidenciasAlmacenadas.datos_recorrido) {
                const rec = evidenciasAlmacenadas.datos_recorrido;
                if(rec.kilometraje) document.getElementById('kilometraje_patio').value = rec.kilometraje;
                if(rec.nivel_combustible) {
                    const r = document.querySelector(`input[name="nivel_combustible"][value="${rec.nivel_combustible}"]`);
                    if(r) r.checked = true;
                }
            }

            if (evidenciasAlmacenadas.checklist_preoperacional) {
                for (let key in evidenciasAlmacenadas.checklist_preoperacional) {
                    let item = evidenciasAlmacenadas.checklist_preoperacional[key];
                    let radio = document.querySelector(`input.chk-preop[name="${key}"][value="${item.estado}"]`);
                    if (radio) radio.checked = true;
                    
                    let obsInput = document.getElementById('obs_P_' + key);
                    if (obsInput && item.observacion) obsInput.value = item.observacion;

                    let venceInput = document.getElementById('vence_P_' + key);
                    if (venceInput && item.vencimiento && item.vencimiento !== 'N/A') venceInput.value = item.vencimiento;
                }
            }

            if (evidenciasAlmacenadas.checklist_equipos) {
                for (let cat in evidenciasAlmacenadas.checklist_equipos) {
                    if(cat === 'Extintor_Datos') {
                        let ed = evidenciasAlmacenadas.checklist_equipos[cat];
                        if(ed.capacidad) document.getElementById('extintor_capacidad').value = ed.capacidad;
                        if(ed.clase) document.getElementById('extintor_clase').value = ed.clase;
                        if(ed.fecha_recarga) document.getElementById('extintor_f_recarga').value = ed.fecha_recarga;
                        if(ed.proxima_recarga) document.getElementById('extintor_f_vencimiento').value = ed.proxima_recarga;
                        continue;
                    }
                    for (let item in evidenciasAlmacenadas.checklist_equipos[cat]) {
                        let data = evidenciasAlmacenadas.checklist_equipos[cat][item];
                        let radio = document.querySelector(`input.chk-equipo[data-item="${item}"][value="${data.estado}"]`);
                        if (radio) radio.checked = true;

                        let cantInput = document.querySelector(`input.input-cantidad[data-item="${item}"]`);
                        if (cantInput && data.cantidad) cantInput.value = data.cantidad;

                        let venceInput = document.querySelector(`input.input-vencimiento[data-item="${item}"]`);
                        if (venceInput && data.vencimiento && data.vencimiento !== 'N/A') venceInput.value = data.vencimiento;
                    }
                }
            }

            if (evidenciasAlmacenadas.observaciones_generales) {
                document.getElementById('observaciones_generales').value = evidenciasAlmacenadas.observaciones_generales;
            }

            // NOMBRES EN EL FORMULARIO
            if (evidenciasAlmacenadas.firmas_conformidad) {
                if(evidenciasAlmacenadas.firmas_conformidad.entrega) document.getElementById('nombre_entrega').value = evidenciasAlmacenadas.firmas_conformidad.entrega.nombre || '';
                if(evidenciasAlmacenadas.firmas_conformidad.recibe) document.getElementById('nombre_recibe').value = evidenciasAlmacenadas.firmas_conformidad.recibe.nombre || '';
            }

            // CARGAR MURO DE FIRMAS
            firmaEntregaGuardada = evidenciasAlmacenadas.firmas_conformidad?.entrega?.firma || `<%- registro.firma_admin ? registro.firma_admin : '' %>`;
            if (firmaEntregaGuardada && firmaEntregaGuardada.length > 50) {
                document.getElementById('img_entrega').src = firmaEntregaGuardada;
                document.getElementById('img_entrega').style.display = 'block';
                document.getElementById('muro_entrega').style.display = 'block';
                document.getElementById('caja_entrega').style.display = 'none';
            } else {
                habilitarFirma('entrega', true); // No había firma, forzar edición
            }

            firmaRecibeGuardada = evidenciasAlmacenadas.firmas_conformidad?.recibe?.firma || '';
            if (firmaRecibeGuardada && firmaRecibeGuardada.length > 50) {
                document.getElementById('img_recibe').src = firmaRecibeGuardada;
                document.getElementById('img_recibe').style.display = 'block';
                document.getElementById('muro_recibe').style.display = 'block';
                document.getElementById('caja_recibe').style.display = 'none';
            } else {
                habilitarFirma('recibe', true); // No había firma, forzar edición
            }

            // DIBUJAR PUNTOS DE EVIDENCIA Y DAÑOS
            for (let zona in evidenciasAlmacenadas.rutina) {
                document.querySelectorAll('.hotspot').forEach(hp => {
                    if(hp.getAttribute('onclick') && hp.getAttribute('onclick').includes(zona)) {
                        hp.classList.add('completed'); hp.innerHTML = '<i class="fas fa-check"></i>';
                    }
                });
            }

            for (let zona in evidenciasAlmacenadas.equipos) {
                let idBtn = '';
                if(zona.includes('Botiquín')) idBtn = 'btn-foto-BOT';
                else if(zona.includes('Carreteras')) idBtn = 'btn-foto-CAR';
                else if(zona.includes('Ambiental')) idBtn = 'btn-foto-AMB';
                else if(zona.includes('Extintor')) idBtn = 'btn-foto-EXT';
                const btn = document.getElementById(idBtn);
                if(btn) { btn.classList.replace('btn-outline-primary', 'btn-success'); btn.innerHTML = '<i class="fas fa-check-circle me-2"></i> Fotografía Adjuntada'; }
            }

            if (evidenciasAlmacenadas.danos.length > 0) {
                evidenciasAlmacenadas.danos.forEach(dano => {
                    const contenedor = document.getElementById(dano.contenedorId);
                    if (contenedor) {
                        const pin = document.createElement('div'); pin.className = 'damage-pin';
                        pin.style.left = dano.x + '%'; pin.style.top = dano.y + '%';
                        pin.style.opacity = '1'; pin.style.transform = 'translate(-50%, -50%)'; 
                        pin.innerHTML = '<i class="fas fa-exclamation"></i>'; contenedor.appendChild(pin);
                    }
                });
            }
        });

        // FUNCIONES DEL MURO DE FIRMAS
        const signaturePadEntrega = new SignaturePad(document.getElementById('firmaEntregaCanvas'), { penColor: "rgb(15, 23, 42)" });
        const signaturePadRecibe = new SignaturePad(document.getElementById('firmaRecibeCanvas'), { penColor: "rgb(15, 23, 42)" });

        function redimensionarCanvasSolo(idCanvas) {
            const canvas = document.getElementById(idCanvas);
            const ratio = Math.max(window.devicePixelRatio || 1, 1);
            canvas.width = canvas.offsetWidth * ratio;
            canvas.height = canvas.offsetHeight * ratio;
            canvas.getContext("2d").scale(ratio, ratio);
            if (idCanvas === 'firmaEntregaCanvas') signaturePadEntrega.clear();
            if (idCanvas === 'firmaRecibeCanvas') signaturePadRecibe.clear();
        }

        function habilitarFirma(tipo, forzar = false) {
            if (tipo === 'entrega') {
                editandoEntrega = true;
                document.getElementById('muro_entrega').style.display = 'none';
                document.getElementById('caja_entrega').style.display = 'block';
                redimensionarCanvasSolo('firmaEntregaCanvas');
                if (forzar) document.querySelector('#caja_entrega button.text-secondary').style.display = 'none';
            } else {
                editandoRecibe = true;
                document.getElementById('muro_recibe').style.display = 'none';
                document.getElementById('caja_recibe').style.display = 'block';
                redimensionarCanvasSolo('firmaRecibeCanvas');
                if (forzar) document.querySelector('#caja_recibe button.text-secondary').style.display = 'none';
            }
        }

        function cancelarFirma(tipo) {
            if (tipo === 'entrega') {
                editandoEntrega = false;
                document.getElementById('muro_entrega').style.display = 'block';
                document.getElementById('caja_entrega').style.display = 'none';
            } else {
                editandoRecibe = false;
                document.getElementById('muro_recibe').style.display = 'block';
                document.getElementById('caja_recibe').style.display = 'none';
            }
        }

        function limpiarFirmaCanvas(tipo) {
            if(tipo === 'entrega') signaturePadEntrega.clear();
            else signaturePadRecibe.clear();
        }

        // ==========================================
        // RESTO DE FUNCIONES ESTÁNDAR
        // ==========================================
        function cambiarVistaPrincipal() {
            const tipo = document.getElementById('selectorTipoEquipo').value;
            if (tipo === 'CARRO') {
                document.getElementById('vista-carro').style.display = 'block';
                document.getElementById('vista-maquina').style.display = 'none';
                document.getElementById('div-datos-carro').style.display = 'block';
                document.getElementById('div-mantenimientos').style.display = 'none';
            } else {
                document.getElementById('vista-carro').style.display = 'none';
                document.getElementById('vista-maquina').style.display = 'block';
                document.getElementById('div-datos-carro').style.display = 'none';
                document.getElementById('div-mantenimientos').style.display = 'block';
            }
        }

        function marcarTodosBuenoPreop() { document.querySelectorAll('.chk-preop[value="BUENO"]').forEach(r => r.checked = true); }
        function marcarGrupoEquipos(acordeonId) { const acc = document.getElementById(acordeonId); if(acc) acc.querySelectorAll('.chk-equipo[value="B"]').forEach(r => r.checked = true); }

        let zonaActual = ''; let danoTemporal = null; let fotoBase64Temporal = '';
        const modalCamara = new bootstrap.Modal(document.getElementById('modalCamara'));

        function abrirCamara(zona) {
            zonaActual = zona; danoTemporal = null;
            document.getElementById('modalTitulo').innerText = zona;
            document.getElementById('fotoInput').value = ''; document.getElementById('comentarioInput').value = '';
            document.getElementById('foto-preview-container').style.display = 'none'; fotoBase64Temporal = '';
            
            if(evidenciasAlmacenadas.rutina[zona]) {
                fotoBase64Temporal = evidenciasAlmacenadas.rutina[zona].foto;
                document.getElementById('foto-preview').src = fotoBase64Temporal;
                document.getElementById('foto-preview-container').style.display = 'block';
                document.getElementById('comentarioInput').value = evidenciasAlmacenadas.rutina[zona].comentario;
            } else if (evidenciasAlmacenadas.equipos[zona]) {
                fotoBase64Temporal = evidenciasAlmacenadas.equipos[zona].foto;
                document.getElementById('foto-preview').src = fotoBase64Temporal;
                document.getElementById('foto-preview-container').style.display = 'block';
                document.getElementById('comentarioInput').value = evidenciasAlmacenadas.equipos[zona].comentario;
            }
            modalCamara.show();
        }

        function iniciarCapturaDano(event, contenedorId) {
            if(event.target.classList.contains('damage-pin')) return;
            const rect = event.currentTarget.getBoundingClientRect();
            const x = ((event.clientX - rect.left) / rect.width) * 100;
            const y = ((event.clientY - rect.top) / rect.height) * 100;
            
            zonaActual = 'DANO_DINAMICO';
            danoTemporal = { id: 'dano_' + Date.now(), x: x, y: y, contenedorId: contenedorId };
            
            document.getElementById('modalTitulo').innerText = 'Registrar Daño o Novedad';
            document.getElementById('fotoInput').value = ''; document.getElementById('comentarioInput').value = '';
            document.getElementById('foto-preview-container').style.display = 'none'; fotoBase64Temporal = '';
            modalCamara.show();
        }

        function comprimirYProcesarFoto(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = new Image(); img.src = e.target.result;
                    img.onload = function() {
                        const canvas = document.createElement('canvas');
                        const MAX_WIDTH = 800; const MAX_HEIGHT = 800;
                        let width = img.width; let height = img.height;
                        if (width > height) { if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; } } 
                        else { if (height > MAX_HEIGHT) { width *= MAX_HEIGHT / height; height = MAX_HEIGHT; } }
                        canvas.width = width; canvas.height = height;
                        const ctx = canvas.getContext('2d'); ctx.drawImage(img, 0, 0, width, height);
                        fotoBase64Temporal = canvas.toDataURL('image/jpeg', 0.6);
                        document.getElementById('foto-preview').src = fotoBase64Temporal;
                        document.getElementById('foto-preview-container').style.display = 'block';
                    }
                }; reader.readAsDataURL(input.files[0]);
            }
        }

        function guardarEvidencia() {
            if (!fotoBase64Temporal) { alert('Debe tomar una fotografía.'); return; }
            
            if (zonaActual === 'DANO_DINAMICO') {
                evidenciasAlmacenadas.danos.push({ id: danoTemporal.id, x: danoTemporal.x, y: danoTemporal.y, foto: fotoBase64Temporal, comentario: document.getElementById('comentarioInput').value, contenedorId: danoTemporal.contenedorId });
                const contenedor = document.getElementById(danoTemporal.contenedorId);
                const pin = document.createElement('div'); pin.className = 'damage-pin';
                pin.style.left = danoTemporal.x + '%'; pin.style.top = danoTemporal.y + '%';
                pin.innerHTML = '<i class="fas fa-exclamation"></i>'; contenedor.appendChild(pin);
            } else if (zonaActual.startsWith('Foto ')) {
                evidenciasAlmacenadas.equipos[zonaActual] = { foto: fotoBase64Temporal, comentario: document.getElementById('comentarioInput').value };
                let idBtn = '';
                if(zonaActual.includes('Botiquín')) idBtn = 'btn-foto-BOT';
                else if(zonaActual.includes('Carreteras')) idBtn = 'btn-foto-CAR';
                else if(zonaActual.includes('Ambiental')) idBtn = 'btn-foto-AMB';
                else if(zonaActual.includes('Extintor')) idBtn = 'btn-foto-EXT';
                const btn = document.getElementById(idBtn);
                if(btn) { btn.classList.replace('btn-outline-primary', 'btn-success'); btn.innerHTML = '<i class="fas fa-check-circle me-2"></i> Fotografía Adjuntada'; }
            } else {
                evidenciasAlmacenadas.rutina[zonaActual] = { foto: fotoBase64Temporal, comentario: document.getElementById('comentarioInput').value };
                document.querySelectorAll('.hotspot').forEach(hp => {
                    if(hp.getAttribute('onclick') && hp.getAttribute('onclick').includes(zonaActual)) {
                        hp.classList.add('completed'); hp.innerHTML = '<i class="fas fa-check"></i>';
                    }
                });
            }
            modalCamara.hide();
        }

        // ==========================================
        // PROCESAR Y ENVIAR
        // ==========================================
        function enviarFormulario() {
            if (!document.getElementById('nombre_entrega').value.trim() || !document.getElementById('nombre_recibe').value.trim()) {
                alert("Por favor, ingrese el nombre de quien entrega y quien recibe."); return;
            }
            
            let firmaFinalEntrega = '';
            let firmaFinalRecibe = '';

            // VALIDAR FIRMA ENTREGA
            if (editandoEntrega) {
                if (signaturePadEntrega.isEmpty()) { alert("Por favor, registre la nueva firma de quien ENTREGA."); return; }
                firmaFinalEntrega = signaturePadEntrega.toDataURL();
            } else {
                firmaFinalEntrega = firmaEntregaGuardada;
            }

            // VALIDAR FIRMA RECIBE
            if (editandoRecibe) {
                if (signaturePadRecibe.isEmpty()) { alert("Por favor, registre la nueva firma de quien RECIBE."); return; }
                firmaFinalRecibe = signaturePadRecibe.toDataURL();
            } else {
                firmaFinalRecibe = firmaRecibeGuardada;
            }

            const tipo = document.getElementById('selectorTipoEquipo').value;

            if (tipo === 'CARRO') {
                const checklistPreop = {};
                document.querySelectorAll('.chk-preop:checked').forEach(radio => { 
                    const obsInput = document.getElementById('obs_P_' + radio.name); const venceInput = document.getElementById('vence_P_' + radio.name);
                    checklistPreop[radio.name] = { estado: radio.value, observacion: obsInput ? obsInput.value : '', vencimiento: venceInput ? (venceInput.value || 'N/A') : undefined };
                });
                evidenciasAlmacenadas['checklist_preoperacional'] = checklistPreop;

                const checklistEquipos = { "Botiquín": {}, "Kit de Carreteras": {}, "Kit Ambiental": {}, "Extintor": {}, "Extintor_Datos": { capacidad: document.getElementById('extintor_capacidad').value, clase: document.getElementById('extintor_clase').value, fecha_recarga: document.getElementById('extintor_f_recarga').value, proxima_recarga: document.getElementById('extintor_f_vencimiento').value } };
                document.querySelectorAll('.chk-equipo:checked').forEach(radio => {
                    const cat = radio.getAttribute('data-categoria'); 
                    const item = radio.getAttribute('data-item');
                    if (checklistEquipos[cat]) {
                        if (!checklistEquipos[cat][item]) checklistEquipos[cat][item] = {};
                        checklistEquipos[cat][item].estado = radio.value;
                        
                        const contenedor = radio.closest('.mb-3') || radio.closest('.mb-2');
                        if (contenedor) {
                            const inputFecha = contenedor.querySelector('.input-vencimiento');
                            if (inputFecha) checklistEquipos[cat][item].vencimiento = inputFecha.value || 'N/A';
                            
                            const inputCant = contenedor.querySelector('.input-cantidad');
                            if (inputCant) checklistEquipos[cat][item].cantidad = inputCant.value || '0';
                        }
                    }
                });
                evidenciasAlmacenadas['checklist_equipos'] = checklistEquipos;
                delete evidenciasAlmacenadas['datos_mantenimiento']; 

                const km = document.getElementById('kilometraje_patio').value || '0';
                const fuelSelected = document.querySelector('input[name="nivel_combustible"]:checked');
                const combustible = fuelSelected ? fuelSelected.value : 'No registrado';
                evidenciasAlmacenadas['datos_recorrido'] = { kilometraje: km, nivel_combustible: combustible };

            } else {
                evidenciasAlmacenadas['datos_mantenimiento'] = {
                    ultimo_mantenimiento: document.getElementById('ultimo_mantenimiento').value || 'No registrado',
                    horometro: document.getElementById('horometro').value || 'No registrado'
                };
                delete evidenciasAlmacenadas['checklist_preoperacional']; 
            }

            evidenciasAlmacenadas['firmas_conformidad'] = {
                entrega: { nombre: document.getElementById('nombre_entrega').value.trim(), firma: firmaFinalEntrega },
                recibe: { nombre: document.getElementById('nombre_recibe').value.trim(), firma: firmaFinalRecibe }
            };

            evidenciasAlmacenadas['observaciones_generales'] = document.getElementById('observaciones_generales').value;
            document.getElementById('evidenciasJSON').value = JSON.stringify(evidenciasAlmacenadas);
            document.getElementById('firmaBase64').value = firmaFinalEntrega; 
            
            const btn = document.querySelector('button[onclick="enviarFormulario()"]');
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> GUARDANDO CAMBIOS...';
            btn.disabled = true;

            document.getElementById('form-patio').submit();
        }
    </script>
</body>
</html>