<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Auditoría de Patio - <%= registro.vehiculo_placa %></title>
    <style>
        @page { margin: 10mm; size: letter; }
        body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-size: 8px; line-height: 1.2; color: #1e293b; }
        
        /* CABECERA */
        .header-table { width: 100%; border: 2px solid #0f172a; border-collapse: collapse; margin-bottom: 10px; }
        .header-table td { padding: 4px 8px; border: 1px solid #cbd5e1; font-size: 9px; }
        .header-title { background-color: #0f172a; color: white; font-weight: bold; text-align: center; font-size: 11px; text-transform: uppercase; letter-spacing: 1px; }
        
        /* TÍTULOS DE SECCIÓN */
        .section-title { background-color: #e50914; color: white; padding: 4px 8px; font-size: 9px; font-weight: bold; margin-top: 12px; margin-bottom: 6px; text-transform: uppercase; border-radius: 2px; }
        
        /* TABLAS Y COLUMNAS */
        table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
        th, td { border: 1px solid #cbd5e1; padding: 3px 4px; text-align: left; }
        th { background-color: #f1f5f9; font-weight: bold; font-size: 7.5px; text-transform: uppercase; color: #475569; text-align: center;}
        
        .col-2 { column-count: 2; column-gap: 15px; }
        .col-3 { column-count: 3; column-gap: 10px; }
        .break-avoid { break-inside: avoid; page-break-inside: avoid; }
        
        /* ESTADOS */
        .est-B { color: #166534; font-weight: bold; }
        .est-M { color: #b91c1c; font-weight: bold; }
        .est-NA { color: #94a3b8; }
        
        /* MOSAICO DE FOTOS (GRANDES Y COMPLETAS) */
        .grid-fotos { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 15px; }
        
        /* 3 fotos por fila para darles más espacio a lo ancho */
        .foto-card { 
            width: calc(33.33% - 6px); 
            border: 1px solid #cbd5e1; 
            background: #f8fafc; 
            padding: 5px; 
            box-sizing: border-box; 
            text-align: center; 
            border-radius: 4px; 
            break-inside: avoid; 
        }
        .foto-card.is-dano { border: 2px solid #ef4444; background: #fef2f2; }
        
        /* object-fit: contain (para que no se corten) y altura aumentada a 160px */
        .foto-card img { 
            width: 100%; 
            height: 160px; 
            object-fit: contain; 
            border-radius: 4px; 
            background: #ffffff; 
            border: 1px solid #e2e8f0;
        }
        
        .foto-title { font-size: 8px; font-weight: bold; background: #0f172a; color: white; padding: 4px; margin-bottom: 5px; text-transform: uppercase; border-radius: 2px; }
        .foto-card.is-dano .foto-title { background: #ef4444; }
        .foto-obs { font-size: 8px; color: #b91c1c; margin-top: 5px; font-weight: bold; }
        
        /* CHECKLIST ITEMS (DIVS PARA EVITAR CORTES DE PÁGINA) */
        .chk-item { border-bottom: 1px dashed #cbd5e1; padding-bottom: 3px; margin-bottom: 4px; break-inside: avoid; }
        .chk-header { display: flex; justify-content: space-between; align-items: center; }
        .chk-name { font-weight: bold; text-transform: uppercase; font-size: 7.5px; color: #334155; }
        .chk-meta { font-size: 7px; color: #64748b; margin-top: 1px; }
        .chk-meta strong { color: #b91c1c; }

        /* FIRMAS Y FOOTER */
        .firmas-container { width: 100%; margin-top: 15px; break-inside: avoid; }
        .footer { text-align: center; font-size: 7px; color: #94a3b8; border-top: 1px solid #e2e8f0; padding-top: 5px; margin-top: 15px; }
    </style>
</head>
<body>

    <!-- FUNCIONES DE FORMATEO -->
    <% 
        function formatDate(dateString) {
            if (!dateString || dateString === 'N/A' || dateString === '') return 'N/A';
            if (dateString.includes('-')) {
                const parts = dateString.split('T')[0].split('-');
                if(parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]}`;
            }
            return dateString;
        }

        function formatVal(val) {
            if(val === 'B' || val === 'BUENO') return '<span class="est-B">✓ BUENO</span>';
            if(val === 'M' || val === 'MALO') return '<span class="est-M">❌ MALO</span>';
            return '<span class="est-NA">N/A</span>';
        }
    %>

    <!-- 1. CABECERA -->
    <table class="header-table">
        <tr>
            <td colspan="4" class="header-title">AUDITORÍA INTEGRAL DE PATIO - OMEGAGROUP</td>
        </tr>
        <tr>
            <td width="15%"><strong>PLACA / EQUIPO:</strong></td>
            <td width="35%" style="font-size: 11px; font-weight: bold; color: #e50914;"><%= registro.vehiculo_placa %></td>
            <td width="15%"><strong>MOVIMIENTO:</strong></td>
            <td width="35%" style="font-weight: bold;"><%= registro.tipo_movimiento === 'ENTRADA' ? 'Llegada a Patio' : 'Salida a Operación' %></td>
        </tr>
        <tr>
            <td><strong>FECHA / HORA:</strong></td>
            <td><%= new Date(registro.fecha_registro).toLocaleString('es-CO') %></td>
            <td><strong>AUDITOR:</strong></td>
            <td><%= registro.admin.nombre %></td>
        </tr>
    </table>

    <!-- 2. RECOPILACIÓN Y RENDERIZADO DE FOTOGRAFÍAS -->
    <% 
        let fotos = [];
        // Fotos de rutina (Estado general)
        if (datos.rutina) {
            for (let zona in datos.rutina) fotos.push({ titulo: zona, foto: datos.rutina[zona].foto, obs: datos.rutina[zona].comentario, isDano: false });
        }
        // Fotos de equipos (Botiquín, Extintor, etc)
        if (datos.equipos) {
            for (let zona in datos.equipos) fotos.push({ titulo: zona, foto: datos.equipos[zona].foto, obs: datos.equipos[zona].comentario, isDano: false });
        }
        // Fotos de daños dinámicos (Pines rojos)
        if (datos.danos && datos.danos.length > 0) {
            datos.danos.forEach((dano, index) => {
                fotos.push({ titulo: `⚠ NOVEDAD / DAÑO #${index + 1}`, foto: dano.foto, obs: dano.comentario, isDano: true });
            });
        }
    %>

    <% if (fotos.length > 0) { %>
        <div class="section-title">1. EVIDENCIA FOTOGRÁFICA Y NOVEDADES</div>
        <div class="grid-fotos">
            <% fotos.forEach(f => { %>
                <div class="foto-card <%= f.isDano ? 'is-dano' : '' %>">
                    <div class="foto-title"><%= f.titulo %></div>
                    <img src="<%= f.foto %>">
                    <% if(f.obs && f.obs.trim() !== '') { %>
                        <div class="foto-obs"><%= f.obs %></div>
                    <% } %>
                </div>
            <% }) %>
        </div>
    <% } %>

    <!-- 3. INSPECCIÓN PREOPERACIONAL (CON OBSERVACIONES Y FECHAS) -->
    <% if (datos.checklist_preoperacional && Object.keys(datos.checklist_preoperacional).length > 0) { %>
        <div class="section-title">2. INSPECCIÓN PREOPERACIONAL DETALLADA</div>
        <div class="col-2">
            <% for (let key in datos.checklist_preoperacional) { 
                let item = datos.checklist_preoperacional[key];
                // Restauramos el nombre original quitando los guiones bajos
                let nombreLimpio = key.replace(/_/g, ' '); 
            %>
                <div class="chk-item">
                    <div class="chk-header">
                        <span class="chk-name"><%= nombreLimpio %></span>
                        <span style="font-size: 7.5px;"><%- formatVal(item.estado) %></span>
                    </div>
                    <% if (item.vencimiento && item.vencimiento !== 'N/A' && item.vencimiento !== '') { %>
                        <div class="chk-meta"><strong>Vence:</strong> <%= formatDate(item.vencimiento) %></div>
                    <% } %>
                    <% if (item.observacion && item.observacion.trim() !== '') { %>
                        <div class="chk-meta"><strong>Obs:</strong> <%= item.observacion %></div>
                    <% } %>
                </div>
            <% } %>
        </div>
    <% } %>

    <!-- 4. EQUIPOS DE EMERGENCIA -->
    <% if (datos.checklist_equipos) { let eq = datos.checklist_equipos; %>
        <div class="section-title">3. EQUIPOS DE PREVENCIÓN Y EMERGENCIAS</div>
        
        <!-- Extintor -->
        <% if (eq.Extintor_Datos && (eq.Extintor_Datos.capacidad || eq.Extintor_Datos.clase)) { %>
            <table style="margin-bottom: 8px;" class="break-avoid">
                <tr>
                    <th width="15%" style="background-color: #f59e0b; color: white;">EXTINTOR</th>
                    <td width="30%"><strong>Tipo:</strong> <%= eq.Extintor_Datos.clase || '-' %> | <strong>Cap:</strong> <%= eq.Extintor_Datos.capacidad || '-' %></td>
                    <td width="25%"><strong>Recarga:</strong> <%= formatDate(eq.Extintor_Datos.fecha_recarga) %></td>
                    <td width="30%"><strong>Vencimiento:</strong> <%= formatDate(eq.Extintor_Datos.proxima_recarga) %></td>
                </tr>
            </table>
        <% } %>

        <div class="col-2">
            <!-- Botiquín -->
            <% if (eq["Botiquín"] && Object.keys(eq["Botiquín"]).length > 0) { %>
                <div class="break-avoid">
                    <div style="font-weight: bold; background: #e2e8f0; padding: 3px; border: 1px solid #cbd5e1; border-bottom: none; text-align: center; color: #0f172a;">BOTIQUÍN DE PRIMEROS AUXILIOS</div>
                    <table>
                        <tr><th width="50%">ÍTEM</th><th width="15%">CANT</th><th width="12%">EST</th><th width="23%">VENCE</th></tr>
                        <% for (let item in eq["Botiquín"]) { let d = eq["Botiquín"][item]; %>
                        <tr>
                            <td style="font-size: 7px;"><%= item %></td>
                            <td style="font-size: 6.5px; text-align: center;"><%= d.cantidad || '-' %></td>
                            <td style="text-align: center;"><%- formatVal(d.estado) %></td>
                            <td style="font-size: 7px; text-align: center;"><%= d.vencimiento && d.vencimiento !== 'N/A' ? formatDate(d.vencimiento) : '-' %></td>
                        </tr>
                        <% } %>
                    </table>
                </div>
            <% } %>

            <!-- Kits sin fecha -->
            <% ["Kit de Carreteras", "Kit Ambiental", "Extintor"].forEach(kitName => { 
                if(eq[kitName] && Object.keys(eq[kitName]).length > 0) { 
            %>
                <div class="break-avoid mb-2">
                    <div style="font-weight: bold; background: #e2e8f0; padding: 3px; border: 1px solid #cbd5e1; border-bottom: none; text-align: center; color: #0f172a;"><%= kitName.toUpperCase() %></div>
                    <table>
                        <tr><th width="65%">ÍTEM</th><th width="15%">CANT</th><th width="20%">ESTADO</th></tr>
                        <% for (let item in eq[kitName]) { let d = eq[kitName][item]; %>
                        <tr>
                            <td style="font-size: 7px;"><%= item %></td>
                            <td style="font-size: 6.5px; text-align: center;"><%= d.cantidad || '-' %></td>
                            <td style="text-align: center;"><%- formatVal(d.estado) %></td>
                        </tr>
                        <% } %>
                    </table>
                </div>
            <%  } }); %>
        </div>
    <% } %>

    <!-- 5. OBSERVACIONES GENERALES Y FIRMA -->
    <div class="section-title">4. OBSERVACIONES GENERALES Y CIERRE</div>
    <table class="firmas-container" style="border: none;">
        <tr>
            <td style="border: none; width: 65%; vertical-align: top; padding-right: 15px;">
                <div style="font-weight: bold; margin-bottom: 4px;">OBSERVACIONES DEL AUDITOR:</div>
                <div style="border: 1px dashed #94a3b8; padding: 8px; height: 60px; font-size: 8px; background: #fdfdfd; border-radius: 4px;">
                    <%= datos.observaciones_generales || 'Sin observaciones adicionales registradas durante la auditoría.' %>
                </div>
            </td>
            <td style="border: none; width: 35%; text-align: center; vertical-align: bottom;">
                <% if(registro.firma_admin) { %>
                    <img src="<%= registro.firma_admin %>" style="max-height: 60px; margin-bottom: 2px;"><br>
                <% } %>
                <div style="border-top: 1px solid #0f172a; padding-top: 4px; font-weight: bold; font-size: 9px; width: 90%; margin: 0 auto;">
                    <%= registro.admin.nombre %><br>
                    <span style="font-size: 7px; font-weight: normal; color: #64748b;">Auditor / Jefe de Operaciones</span>
                </div>
            </td>
        </tr>
    </table>

    <div class="footer">
        Documento generado automáticamente por el Sistema Integral OmegaGroup el <%= fechaImpresion %>.
    </div>

</body>
</html>