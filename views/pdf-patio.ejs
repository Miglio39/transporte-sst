<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Auditoría de Patio</title>
    <style>
        body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #111; margin: 0; padding: 10px; font-size: 12px; }
        .header { border-bottom: 3px solid #e50914; padding-bottom: 10px; margin-bottom: 20px; text-align: center; }
        .header h1 { margin: 0; font-size: 24px; color: #0f172a; text-transform: uppercase; }
        .header p { margin: 5px 0 0 0; color: #64748b; font-size: 14px; }
        
        .info-table { width: 100%; border-collapse: collapse; margin-bottom: 25px; }
        .info-table th, .info-table td { border: 1px solid #cbd5e1; padding: 10px; text-align: left; }
        .info-table th { background-color: #f8fafc; color: #0f172a; width: 25%; font-size: 11px; text-transform: uppercase; }
        .info-table td { font-weight: bold; font-size: 14px; }
        .movimiento-ENTRADA { color: #10b981; }
        .movimiento-SALIDA { color: #f59e0b; }

        .evidencia-grid { display: block; width: 100%; }
        .evidencia-card { width: 48%; display: inline-block; vertical-align: top; margin-bottom: 15px; border: 1px solid #cbd5e1; border-radius: 6px; overflow: hidden; page-break-inside: avoid; margin-right: 1%; }
        .evidencia-titulo { background: #0f172a; color: white; padding: 8px; font-size: 12px; font-weight: bold; text-align: center; margin: 0; }
        .evidencia-img { width: 100%; height: 200px; object-fit: contain; background: #f1f5f9; border-bottom: 1px solid #cbd5e1; }
        .evidencia-obs { padding: 10px; font-size: 11px; color: #334155; min-height: 40px; }

        .firma-box { width: 300px; margin: 30px auto 0; text-align: center; }
        .firma-box img { max-width: 100%; height: 100px; border-bottom: 1px solid #000; }
        .firma-box p { margin: 5px 0 0 0; font-weight: bold; font-size: 12px; }
        .firma-box span { font-size: 10px; color: #64748b; }
    </style>
</head>
<body>

    <div class="header">
        <h1>Control de Auditoría Visual (Patio)</h1>
        <p>Documento de Inspección Física de Equipos y Vehículos</p>
    </div>

    <table class="info-table">
        <tr>
            <th>Placa / Identificador</th>
            <td><%= registro.vehiculo_placa %></td>
            <th>Tipo de Movimiento</th>
            <td class="movimiento-<%= registro.tipo_movimiento %>"><%= registro.tipo_movimiento %></td>
        </tr>
        <tr>
            <th>Fecha de Registro</th>
            <td><%= fechaImpresion %></td>
            <th>Auditor / Jefe</th>
            <td><%= registro.admin.nombre %></td>
        </tr>
    </table>

    <h3 style="border-bottom: 1px solid #e2e8f0; padding-bottom: 5px; color: #0f172a;">Registro Fotográfico</h3>
    
    <div class="evidencia-grid">
        <% 
            const zonas = Object.keys(evidencias);
            if (zonas.length === 0) { 
        %>
            <p style="text-align: center; padding: 20px; background: #f8fafc; color: #64748b; border: 1px dashed #cbd5e1;">
                El equipo no presentó novedades visuales (No se adjuntaron fotografías).
            </p>
        <% } else { %>
            <% zonas.forEach(zona => { 
                const data = evidencias[zona];
            %>
                <div class="evidencia-card">
                    <h4 class="evidencia-titulo"><%= zona.toUpperCase() %></h4>
                    <img src="<%= data.foto %>" class="evidencia-img">
                    <div class="evidencia-obs">
                        <strong>Novedad:</strong> <%= data.comentario || 'Sin comentarios registrados.' %>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>

    <div class="firma-box">
        <img src="<%= registro.firma_admin %>" alt="Firma del Auditor">
        <p><%= registro.admin.nombre %></p>
        <span>Jefe de Operaciones / Auditor Autorizado</span>
    </div>

</body>
</html>