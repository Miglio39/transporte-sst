    <!-- MODAL DE FIRMA MASIVA -->
    <div class="modal fade" id="modalFirmaMasiva" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow" style="border-radius: 14px; overflow: hidden;">
                <div class="modal-header bg-dark text-white">
                    <h6 class="modal-title fw-bold"><i class="fas fa-pen-nib me-2"></i> Firma Masiva de Inspecciones</h6>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <p class="text-muted small mb-3">
                        Esta firma se aplicará simultáneamente a <strong id="contadorSeleccionadas" class="text-primary fs-5">0</strong> inspecciones seleccionadas.
                    </p>
                    <div style="border: 2px dashed #cbd5e1; border-radius: 10px; background: #fff; overflow: hidden;">
                        <canvas id="firmaMasivaPad" style="width: 100%; height: 170px; touch-action: none; cursor: crosshair;"></canvas>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-danger mt-3 fw-semibold" onclick="signaturePadMasiva && signaturePadMasiva.clear()">
                        <i class="fas fa-eraser me-1"></i> Limpiar Pizarra
                    </button>
                </div>
                <div class="modal-footer bg-light border-0">
                    <button type="button" class="btn btn-sm btn-secondary fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-sm btn-success fw-bold px-4" onclick="enviarFirmaMasiva(this)">
                        <i class="fas fa-check-double me-1"></i> Aplicar a Todas
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ==============================================================
         SCRIPTS: BOOTSTRAP, CHART.JS, SIGNATURE PAD Y MOTOR DE FILTROS
         ============================================================== -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.0.0/dist/signature_pad.umd.min.js"></script>

    <script>
        // =========================================================
        // 1. PRESETS RÁPIDOS DE FECHA PARA EXPORTACIÓN
        // =========================================================
        function setRangoExportacion(tipo) {
            const hoy = new Date();
            let inicio, fin;
            if (tipo === 'mes_actual') {
                inicio = new Date(hoy.getFullYear(), hoy.getMonth(), 1);
                fin = new Date(hoy.getFullYear(), hoy.getMonth() + 1, 0);
            } else {
                inicio = new Date(hoy.getFullYear(), hoy.getMonth() - 1, 1);
                fin = new Date(hoy.getFullYear(), hoy.getMonth(), 0);
            }
            const fmt = d => d.toISOString().split('T')[0];
            document.getElementById('expFechaInicio').value = fmt(inicio);
            document.getElementById('expFechaFin').value = fmt(fin);
        }

        // =========================================================
        // 2. MOTOR DE FILTRADO AVANZADO + PAGINACIÓN
        // =========================================================
        let filtroEstadoRapido = 'todos';
        let paginaActual = 1;
        let filasPorPagina = 15;
        let filasCoincidentes = [];

        function seleccionarQuickFilter(btn, tipo) {
            document.querySelectorAll('#quickFilterPills .filter-pill').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            filtroEstadoRapido = tipo;

            // Sincronizar selector de firma si elige "Sin firmar"
            const selFirma = document.getElementById('filtroFirma');
            if (tipo === 'sin_firmar') {
                selFirma.value = 'no';
            } else if (selFirma.value === 'no') {
                selFirma.value = 'TODAS';
            }
            aplicarFiltros(true);
        }

        function aplicarFiltroRapido(tipo) {
            const btn = document.querySelector(`#quickFilterPills .filter-pill[data-quick="${tipo}"]`);
            if (btn) seleccionarQuickFilter(btn, tipo);
            const seccion = document.getElementById('seccionRegistro');
            if (seccion) seccion.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function limpiarFiltros() {
            document.getElementById('filtroTexto').value = '';
            document.getElementById('filtroPlaca').value = 'TODAS';
            document.getElementById('filtroConductor').value = 'TODOS';
            document.getElementById('filtroMes').value = 'TODOS';
            document.getElementById('filtroFirma').value = 'TODAS';
            document.getElementById('filtroDesde').value = '';
            document.getElementById('filtroHasta').value = '';

            const btnTodos = document.querySelector('#quickFilterPills .filter-pill[data-quick="todos"]');
            if (btnTodos) seleccionarQuickFilter(btnTodos, 'todos');
            else aplicarFiltros(true);
        }

        function aplicarFiltros(resetPagina = false) {
            if (resetPagina) paginaActual = 1;

            const texto = (document.getElementById('filtroTexto')?.value || '').trim().toLowerCase();
            const placa = (document.getElementById('filtroPlaca')?.value || 'TODAS').toUpperCase();
            const conductor = (document.getElementById('filtroConductor')?.value || 'TODOS').toLowerCase();
            const mes = document.getElementById('filtroMes')?.value || 'TODOS';
            const firma = document.getElementById('filtroFirma')?.value || 'TODAS';
            const desde = document.getElementById('filtroDesde')?.value || '';
            const hasta = document.getElementById('filtroHasta')?.value || '';

            const todasLasFilas = Array.from(document.querySelectorAll('#tbodyInspecciones tr.fila-inspeccion'));
            filasCoincidentes = [];

            todasLasFilas.forEach(fila => {
                const fPlaca = fila.dataset.placa || '';
                const fCond = fila.dataset.conductor || '';
                const fMes = fila.dataset.mes || '';
                const fFecha = fila.dataset.fecha || '';
                const fEstado = fila.dataset.estado || '';
                const fFirmada = fila.dataset.firmada || '';
                const fTicket = (fila.dataset.ticket || '').toLowerCase();

                const okTexto = !texto || fTicket.includes(texto) || fPlaca.toLowerCase().includes(texto) || fCond.includes(texto);
                const okPlaca = (placa === 'TODAS' || fPlaca === placa);
                const okCond = (conductor === 'todos' || fCond === conductor);
                const okMes = (mes === 'TODOS' || fMes === mes);
                const okFirma = (firma === 'TODAS' || fFirmada === firma);
                const okDesde = (!desde || (fFecha && fFecha >= desde));
                const okHasta = (!hasta || (fFecha && fFecha <= hasta));

                let okRapido = true;
                if (filtroEstadoRapido === 'aprobado') okRapido = (fEstado === 'aprobado');
                else if (filtroEstadoRapido === 'defectos') okRapido = (fEstado === 'defectos');
                else if (filtroEstadoRapido === 'pendiente') okRapido = (fEstado === 'pendiente');
                else if (filtroEstadoRapido === 'sin_firmar') okRapido = (fFirmada === 'no');

                if (okTexto && okPlaca && okCond && okMes && okFirma && okDesde && okHasta && okRapido) {
                    filasCoincidentes.push(fila);
                } else {
                    fila.style.display = 'none';
                    const chk = fila.querySelector('.chk-inspeccion');
                    if (chk && chk.checked) {
                        chk.checked = false;
                        fila.classList.remove('row-selected');
                    }
                }
            });

            renderizarPagina();
            actualizarContadorSeleccion();

            const badgeTotal = document.getElementById('badgeTotalVisibles');
            if (badgeTotal) {
                badgeTotal.innerText = `${filasCoincidentes.length} de ${todasLasFilas.length}`;
            }
        }

        function renderizarPagina() {
            const total = filasCoincidentes.length;
            const totalPaginas = Math.max(1, Math.ceil(total / filasPorPagina));
            if (paginaActual > totalPaginas) paginaActual = totalPaginas;

            const inicio = (paginaActual - 1) * filasPorPagina;
            const fin = inicio + filasPorPagina;

            filasCoincidentes.forEach((fila, idx) => {
                if (idx >= inicio && idx < fin) {
                    fila.style.display = '';
                } else {
                    fila.style.display = 'none';
                }
            });

            const filaSin = document.getElementById('filaSinResultados');
            if (filaSin) filaSin.style.display = total === 0 ? '' : 'none';

            const infoPag = document.getElementById('infoPaginacion');
            const indPag = document.getElementById('indicadorPagina');
            const btnAnt = document.getElementById('btnPagAnterior');
            const btnSig = document.getElementById('btnPagSiguiente');

            if (infoPag) {
                const desdeNum = total === 0 ? 0 : inicio + 1;
                const hastaNum = Math.min(fin, total);
                infoPag.innerText = `Mostrando ${desdeNum}–${hastaNum} de ${total}`;
            }
            if (indPag) indPag.innerText = `Página ${paginaActual} / ${totalPaginas}`;
            if (btnAnt) btnAnt.disabled = (paginaActual <= 1);
            if (btnSig) btnSig.disabled = (paginaActual >= totalPaginas);

            const selectAll = document.getElementById('selectAll');
            if (selectAll) selectAll.checked = false;
        }

        function cambiarPagina(delta) {
            paginaActual += delta;
            renderizarPagina();
        }

        function cambiarPorPagina() {
            filasPorPagina = parseInt(document.getElementById('selectPorPagina').value, 10) || 15;
            paginaActual = 1;
            renderizarPagina();
        }

        // =========================================================
        // 3. MOTOR DE SELECCIÓN Y FIRMA MASIVA
        // =========================================================
        let signaturePadMasiva = null;

        function toggleSeleccionTodos(source) {
            const filasVisibles = document.querySelectorAll('#tbodyInspecciones tr.fila-inspeccion:not([style*="display: none"])');
            filasVisibles.forEach(fila => {
                const chk = fila.querySelector('.chk-inspeccion');
                if (chk) {
                    chk.checked = source.checked;
                    fila.classList.toggle('row-selected', source.checked);
                }
            });
            actualizarContadorSeleccion();
        }

        function actualizarContadorSeleccion() {
            const checkboxes = document.querySelectorAll('.chk-inspeccion');
            let count = 0;
            checkboxes.forEach(cb => {
                const fila = cb.closest('tr');
                if (cb.checked) {
                    count++;
                    if (fila) fila.classList.add('row-selected');
                } else {
                    if (fila) fila.classList.remove('row-selected');
                }
            });

            const badge = document.getElementById('badgeSeleccionados');
            if (badge) {
                badge.innerText = count;
                badge.classList.toggle('d-none', count === 0);
            }
        }

        const modalFirmaEl = document.getElementById('modalFirmaMasiva');
        modalFirmaEl.addEventListener('shown.bs.modal', () => {
            const canvas = document.getElementById('firmaMasivaPad');
            const ratio = Math.max(window.devicePixelRatio || 1, 1);
            canvas.width = canvas.offsetWidth * ratio;
            canvas.height = canvas.offsetHeight * ratio;
            canvas.getContext('2d').scale(ratio, ratio);

            if (!signaturePadMasiva) {
                signaturePadMasiva = new SignaturePad(canvas, {
                    penColor: 'rgb(15, 23, 42)',
                    backgroundColor: 'rgb(255, 255, 255)'
                });
            }
            signaturePadMasiva.clear();
        });

        function abrirModalFirmaMasiva() {
            const seleccionados = Array.from(document.querySelectorAll('.chk-inspeccion:checked')).map(cb => cb.value);
            if (seleccionados.length === 0) {
                return alert('Por favor, marque al menos una inspección de la tabla para firmar.');
            }
            document.getElementById('contadorSeleccionadas').innerText = seleccionados.length;
            const myModal = new bootstrap.Modal(modalFirmaEl);
            myModal.show();
        }

        async function enviarFirmaMasiva(btn) {
            if (!signaturePadMasiva || signaturePadMasiva.isEmpty()) {
                return alert('Debe dibujar su firma antes de aplicar.');
            }

            const ids = Array.from(document.querySelectorAll('.chk-inspeccion:checked')).map(cb => cb.value);
            const firmaBase64 = signaturePadMasiva.toDataURL();

            btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Procesando...';
            btn.disabled = true;

            try {
                const req = await fetch('/admin/inspeccion/firma-masiva', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids, firma_base64: firmaBase64 })
                });
                const res = await req.json();
                
                if (res.success) {
                    alert('¡Firmas aplicadas exitosamente a los documentos!');
                    location.reload();
                } else {
                    alert('Error: ' + res.message);
                    btn.innerHTML = '<i class="fas fa-check-double me-1"></i> Aplicar a Todas';
                    btn.disabled = false;
                }
            } catch (e) {
                alert('Error de conexión con el servidor.');
                btn.innerHTML = '<i class="fas fa-check-double me-1"></i> Aplicar a Todas';
                btn.disabled = false;
            }
        }

        // Inicializar paginación al cargar
        document.addEventListener('DOMContentLoaded', () => {
            aplicarFiltros(true);
        });

        // =========================================================
        // 4. GRÁFICOS ANALÍTICOS (CHART.JS)
        // =========================================================
        const dataEstadosArray = <%- JSON.stringify(dataEstados) %>;
        const labelsEstadosArray = <%- JSON.stringify(labelsEstados) %>;
        const dataFallasArray = <%- JSON.stringify(dataFallas) %>;
        const labelsFallasArray = <%- JSON.stringify(labelsFallas) %>;

        const backgroundColors = labelsEstadosArray.map(label => {
            let str = label.toLowerCase();
            if (str.includes('rechazado') || str.includes('crítico') || str.includes('defecto')) return '#ef4444';
            if (str.includes('curso') || str.includes('pendiente') || str.includes('falla')) return '#f59e0b';
            if (str.includes('completado') || str.includes('aprobado') || str.includes('finalizada')) return '#10b981';
            return '#3b82f6';
        });

        const ctxDonut = document.getElementById('donutChart').getContext('2d');
        new Chart(ctxDonut, {
            type: 'doughnut',
            data: {
                labels: labelsEstadosArray,
                datasets: [{
                    data: dataEstadosArray,
                    backgroundColor: backgroundColors,
                    borderWidth: 3,
                    borderColor: '#ffffff',
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'right',
                        labels: {
                            usePointStyle: true,
                            pointStyle: 'circle',
                            padding: 14,
                            font: { family: "'Inter', sans-serif", size: 12, weight: '600' },
                            color: '#334155'
                        }
                    }
                }
            }
        });

        const ctxBar = document.getElementById('barChart').getContext('2d');
        new Chart(ctxBar, {
            type: 'bar',
            data: {
                labels: labelsFallasArray,
                datasets: [{
                    label: 'Reportes activos',
                    data: dataFallasArray,
                    backgroundColor: '#e50914',
                    borderRadius: 6,
                    barPercentage: 0.55
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { stepSize: 1, font: { family: "'Inter', sans-serif", size: 11 }, color: '#64748b' },
                        grid: { color: '#f1f5f9' },
                        border: { display: false }
                    },
                    x: {
                        ticks: { font: { family: "'Inter', sans-serif", size: 10, weight: '600' }, color: '#475569' },
                        grid: { display: false },
                        border: { display: false }
                    }
                }
            }
        });
    </script>
</body>
</html>