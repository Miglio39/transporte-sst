        <div class="export-card mb-4 p-3 p-lg-4">
            <form method="GET" target="_blank" id="formExportacion" class="row g-3 align-items-end">
                <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2 mb-0">
