<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel Administrativo | OmegaGroup SAS</title>
    <link rel="icon" type="image/jpeg" href="/images/logo-app.jpg">
    <!-- Tipografía Inter, Bootstrap 5 y FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        /* =========================================================
           SISTEMA DE DISEÑO EMPRESARIAL MODERNO - OMEGAGROUP SAS
           ========================================================= */
        :root {
            --surface-bg: #f1f5f9;
            --card-bg: #ffffff;
            --border-color: #e2e8f0;
            --border-subtle: #f1f5f9;
            --text-main: #1e293b;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --omega-dark: #0b1120;
            --omega-slate: #1e293b;
            --omega-red: #e50914;
            --omega-red-hover: #c80812;
            --radius-md: 10px;
            --radius-lg: 14px;
            --shadow-sm: 0 1px 2px rgba(15, 23, 42, 0.05);
            --shadow-md: 0 4px 12px -2px rgba(15, 23, 42, 0.07), 0 2px 4px -2px rgba(15, 23, 42, 0.04);
        }

        body { 
            background-color: var(--surface-bg); 
            color: var(--text-main);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            padding-bottom: 48px;
            -webkit-font-smoothing: antialiased;
        }

        .tabular-nums { font-variant-numeric: tabular-nums; }

        /* =========================================================
           NAVBAR CORPORATIVO STICKY
           ========================================================= */
        .navbar-custom {
            background: linear-gradient(180deg, #0b1120 0%, #111827 100%);
            border-bottom: 2px solid var(--omega-red);
            padding: 0.65rem 1.5rem;
            box-shadow: 0 4px 16px rgba(11, 17, 32, 0.18);
            position: sticky;
            top: 0;
            z-index: 1030;
        }
        
        .navbar-brand img {
            border-radius: 6px;
            background-color: #ffffff;
            padding: 3px 5px;
            object-fit: contain;
        }

        .brand-title {
            letter-spacing: 0.8px;
            font-size: 1.05rem;
            font-weight: 800;
            color: #ffffff;
            line-height: 1.1;
        }
        .brand-subtitle {
            font-size: 0.72rem;
            color: #94a3b8;
            font-weight: 500;
            letter-spacing: 0.4px;
        }

        .nav-pill-btn {
            font-size: 0.82rem;
            font-weight: 600;
            padding: 0.48rem 0.9rem;
            border-radius: 8px;
            color: #e2e8f0;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.08);
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
        }
        .nav-pill-btn:hover, .nav-pill-btn:focus {
            background: rgba(255, 255, 255, 0.14);
            border-color: rgba(255, 255, 255, 0.2);
            color: #ffffff;
        }

        .nav-pill-gps {
            background: rgba(99, 102, 241, 0.16);
            border-color: rgba(129, 140, 248, 0.35);
            color: #e0e7ff;
        }
        .nav-pill-gps:hover {
            background: rgba(99, 102, 241, 0.28);
            border-color: rgba(129, 140, 248, 0.6);
            color: #ffffff;
        }

        .nav-pill-primary {
            background: var(--omega-red);
            border-color: var(--omega-red);
            color: #ffffff;
            box-shadow: 0 2px 8px rgba(229, 9, 20, 0.35);
        }
        .nav-pill-primary:hover {
            background: var(--omega-red-hover);
            border-color: var(--omega-red-hover);
            color: #ffffff;
            transform: translateY(-1px);
        }

        /* BOTÓN DE PERFIL */
        .profile-trigger {
            display: inline-flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.3rem 0.7rem 0.3rem 0.35rem;
            border-radius: 999px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.14);
            color: #f8fafc;
            transition: all 0.2s ease;
            cursor: pointer;
        }
        .profile-trigger:hover {
            background: rgba(255, 255, 255, 0.16);
            border-color: rgba(255, 255, 255, 0.28);
            color: #ffffff;
        }
        .profile-avatar {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e50914 0%, #f97316 100%);
            color: #ffffff;
            font-size: 0.78rem;
            font-weight: 800;
            display: flex;
            align-items: center;
            justify-content: center;
            letter-spacing: 0.5px;
            flex-shrink: 0;
        }
        .profile-avatar-lg {
            width: 56px;
            height: 56px;
            font-size: 1.25rem;
        }
        .profile-meta {
            text-align: left;
            line-height: 1.15;
        }
        .profile-name {
            font-size: 0.8rem;
            font-weight: 600;
            color: #ffffff;
            max-width: 130px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            display: block;
        }
        .profile-role {
            font-size: 0.66rem;
            color: #94a3b8;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            display: block;
        }

        /* DROPDOWNS */
        .dropdown-menu {
            border-radius: 12px;
            border: 1px solid var(--border-color);
            box-shadow: 0 12px 28px -4px rgba(15, 23, 42, 0.14);
            padding: 0.45rem;
            min-width: 220px;
        }
        .dropdown-item {
            padding: 0.55rem 0.85rem;
            font-size: 0.84rem;
            font-weight: 500;
            color: var(--text-main);
            border-radius: 8px;
            transition: all 0.15s ease;
            display: flex;
            align-items: center;
            gap: 0.6rem;
        }
        .dropdown-item:hover {
            background-color: #f1f5f9;
            color: var(--omega-dark);
        }
        .dropdown-item i { width: 18px; text-align: center; }

        .navbar-toggler {
            border: 1px solid rgba(255,255,255,0.2) !important;
            border-radius: 8px;
            padding: 0.45rem 0.65rem;
        }
        .navbar-toggler i { color: #ffffff; font-size: 1.25rem; }

        /* =========================================================
           TARJETAS KPI Y GRÁFICOS
           ========================================================= */
        .section-heading {
            font-size: 1.15rem;
            font-weight: 800;
            color: var(--omega-dark);
            letter-spacing: -0.02em;
        }

        .kpi-card, .surface-card {
            background: var(--card-bg);
            border-radius: var(--radius-lg);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }
        .kpi-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .kpi-card .card-body { padding: 1.2rem 1.3rem; }
        .kpi-title {
            color: var(--text-muted);
            font-size: 0.72rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 0.25rem;
        }
        .kpi-value {
            color: var(--omega-dark);
            font-size: 1.85rem;
            font-weight: 800;
            line-height: 1.1;
            letter-spacing: -0.03em;
        }
        .kpi-sub {
            font-size: 0.76rem;
            color: var(--text-muted);
            margin-top: 0.35rem;
        }
        .kpi-icon-wrapper {
            width: 48px;
            height: 48px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
            flex-shrink: 0;
        }
        .icon-blue { background: #eff6ff; color: #2563eb; }
        .icon-indigo { background: #eef2ff; color: #4f46e5; }
        .icon-red { background: #fef2f2; color: #dc2626; }
        .icon-orange { background: #fff7ed; color: #ea580c; }
        .icon-emerald { background: #ecfdf5; color: #059669; }

        /* GRÁFICOS */
        .chart-header {
            padding: 1rem 1.3rem;
            border-bottom: 1px solid var(--border-subtle);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }
        .chart-title {
            color: var(--omega-dark);
            font-weight: 700;
            font-size: 0.85rem;
            letter-spacing: 0.02em;
            margin: 0;
        }
        .chart-body { padding: 1.15rem; position: relative; height: 255px; width: 100%; }

        /* =========================================================
           CENTRO DE EXPORTACIÓN
           ========================================================= */
        .export-card {
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border: 1px solid var(--border-color);
            border-left: 4px solid var(--omega-red);
            border-radius: var(--radius-lg);
            box-shadow: var(--shadow-sm);
        }
        .preset-btn {
            font-size: 0.72rem;
            font-weight: 600;
            padding: 0.22rem 0.6rem;
            border-radius: 6px;
            background: #f1f5f9;
            color: var(--text-secondary);
            border: 1px solid var(--border-color);
            transition: all 0.15s ease;
        }
        .preset-btn:hover {
            background: #e2e8f0;
            color: var(--omega-dark);
        }

        /* =========================================================
           REGISTRO GENERAL DE INSPECCIONES Y FILTROS
           ========================================================= */
        .filter-pills {
            display: flex;
            flex-wrap: wrap;
            gap: 0.45rem;
        }
        .filter-pill {
            border: 1px solid var(--border-color);
            background: #ffffff;
            color: var(--text-secondary);
            font-size: 0.78rem;
            font-weight: 600;
            padding: 0.38rem 0.8rem;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            cursor: pointer;
            transition: all 0.18s ease;
        }
        .filter-pill:hover {
            background: #f8fafc;
            border-color: #cbd5e1;
            color: var(--omega-dark);
        }
        .filter-pill.active {
            background: var(--omega-dark);
            border-color: var(--omega-dark);
            color: #ffffff;
        }
        .filter-pill .pill-count {
            font-size: 0.7rem;
            padding: 0.1rem 0.45rem;
            border-radius: 999px;
            background: #f1f5f9;
            color: var(--text-secondary);
            font-weight: 700;
        }
        .filter-pill.active .pill-count {
            background: rgba(255, 255, 255, 0.18);
            color: #ffffff;
        }

        .filter-panel {
            background: #f8fafc;
            border-top: 1px solid var(--border-color);
            border-bottom: 1px solid var(--border-color);
            padding: 0.9rem 1.25rem;
        }
        .filter-label {
            font-size: 0.69rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: var(--text-muted);
            margin-bottom: 0.3rem;
            display: block;
        }
        .form-control-modern, .form-select-modern {
            font-size: 0.82rem;
            border-radius: 8px;
            border: 1px solid #cbd5e1;
            background-color: #ffffff;
            color: var(--text-main);
            padding: 0.42rem 0.75rem;
        }
        .form-control-modern:focus, .form-select-modern:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.14);
        }

        /* TABLA DE DATOS */
        .table > :not(caption) > * > * {
            padding: 0.85rem 0.95rem;
            border-bottom-color: var(--border-subtle);
            vertical-align: middle;
        }
        .table thead th {
            background-color: #f8fafc;
            color: var(--text-muted);
            font-size: 0.69rem;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            font-weight: 700;
            border-bottom: 1px solid var(--border-color);
            white-space: nowrap;
        }
        .table tbody td {
            font-size: 0.84rem;
            color: var(--text-main);
        }
        .table-hover tbody tr {
            transition: background-color 0.12s ease;
        }
        .table-hover tbody tr:hover {
            background-color: #f8fafc;
        }
        .table tbody tr.row-selected {
            background-color: #eff6ff !important;
        }

        .plate-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            background: #f1f5f9;
            color: var(--omega-dark);
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 0.25rem 0.55rem;
            font-size: 0.78rem;
            font-weight: 700;
            letter-spacing: 0.5px;
        }

        .driver-avatar {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: #e2e8f0;
            color: #334155;
            font-size: 0.7rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        /* BADGES CORPORATIVOS SUAVES */
        .badge {
            border-radius: 6px;
            padding: 0.38em 0.65em;
            font-weight: 600;
            font-size: 0.74rem;
            letter-spacing: 0.01em;
        }
        .bg-success { background: #dcfce7 !important; color: #166534 !important; border: 1px solid #bbf7d0; }
        .bg-danger { background: #fee2e2 !important; color: #991b1b !important; border: 1px solid #fecaca; }
        .bg-warning { background: #fef3c7 !important; color: #92400e !important; border: 1px solid #fde68a; }
        .bg-dark { background: #f1f5f9 !important; color: var(--text-main) !important; border: 1px solid var(--border-color); }
        .bg-info { background: #e0f2fe !important; color: #075985 !important; border: 1px solid #bae6fd; }

        .sign-status {
            font-size: 0.7rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 0.25rem;
            margin-top: 0.2rem;
        }
        .sign-status.signed { color: #059669; }
        .sign-status.unsigned { color: #94a3b8; }

        /* BOTONES DE ACCIÓN (Ghost) */
        .btn-action {
            border-radius: 7px;
            font-size: 0.78rem;
            font-weight: 500;
            padding: 0.34rem 0.56rem;
            background: #ffffff;
            border: 1px solid var(--border-color);
            color: var(--text-muted);
            transition: all 0.16s ease;
        }
        .btn-action:hover {
            transform: translateY(-1px);
            box-shadow: 0 2px 5px rgba(15, 23, 42, 0.08);
        }
        .btn-action.pdf:hover { background: #fef2f2; border-color: #fca5a5; color: #dc2626; }
        .btn-action.view:hover { background: #e0f2fe; border-color: #7dd3fc; color: #0284c7; }
        .btn-action.edit:hover { background: #f3e8ff; border-color: #d8b4fe; color: #7e22ce; }
        .btn-action.close-btn:hover { background: #fffbeb; border-color: #fcd34d; color: #d97706; }
        .btn-action.delete:hover { background: #fee2e2; border-color: #fca5a5; color: #b91c1c; }

        /* CHECKBOXES */
        .chk-inspeccion, #selectAll {
            width: 17px;
            height: 17px;
            cursor: pointer;
            border-radius: 4px;
        }

        /* PAGINACIÓN */
        .pagination-bar {
            background: #ffffff;
            border-top: 1px solid var(--border-color);
            padding: 0.85rem 1.25rem;
            display: flex;
            flex-wrap: wrap;
            justify-content: space-between;
            align-items: center;
            gap: 0.75rem;
        }

        /* MODO MÓVIL (TARJETAS RESPONSIVE) */
        @media (max-width: 767px) {
            .navbar-custom { padding: 0.65rem 1rem; }
            .mobile-cards thead { display: none; }
            .mobile-cards tbody, .mobile-cards tr, .mobile-cards td { display: block; width: 100%; }
            .mobile-cards tr {
                margin: 0.75rem;
                width: calc(100% - 1.5rem);
                background-color: #ffffff;
                border-radius: 12px;
                box-shadow: var(--shadow-sm);
                border: 1px solid var(--border-color);
                padding: 0.5rem 0.65rem;
            }
            .mobile-cards td {
                display: flex;
                justify-content: space-between;
                align-items: center;
                text-align: right;
                border-bottom: 1px solid var(--border-subtle);
                padding: 0.65rem 0.35rem;
            }
            .mobile-cards td:last-child {
                border-bottom: none;
                flex-direction: column;
                align-items: stretch;
                padding-top: 0.85rem;
            }
            .mobile-cards td::before {
                content: attr(data-label);
                font-weight: 700;
                color: var(--text-muted);
                text-align: left;
                text-transform: uppercase;
                font-size: 0.68rem;
                flex-basis: 38%;
            }
            .action-buttons {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 8px;
                width: 100%;
            }
            .action-buttons .btn {
                width: 100%;
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 6px;
                padding: 0.5rem;
            }
            .action-buttons form { margin: 0; width: 100%; }
            .btn-text-mobile { display: inline-block; font-weight: 600; }
        }
        @media (min-width: 768px) {
            .btn-text-mobile { display: none; }
            .action-buttons { display: flex; gap: 5px; justify-content: flex-end; }
            .text-end-md { text-align: right; }
        }
    </style>
</head>
