            <!-- CABECERA DE SECCIÓN + PESTAÑAS RÁPIDAS + ACCIÓN MASIVA -->
            <div class="p-3 p-lg-4 bg-white">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
                    <div>
                        <h5 class="mb-1 fw-bold text-dark d-flex align-items-center gap-2">
                            <i class="fas fa-clipboard-list text-primary"></i>
                            Registro General de Inspecciones
                            <span class="badge bg-info tabular-nums" id="badgeTotalVisibles"><%= listaInspecciones.length %> de <%= listaInspecciones.length %></span>
                        </h5>
                        <p class="text-muted small mb-0">Filtra por estado, placa, conductor o rango de fechas y firma múltiples inspecciones en un paso.</p>
                    </div>

                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-secondary fw-semibold" data-bs-toggle="collapse" data-bs-target="#filtrosAvanzados" aria-expanded="false">
                            <i class="fas fa-sliders-h me-1"></i> Rango Fechas
                        </button>
                        <button type="button" class="btn btn-sm btn-success fw-bold shadow-sm px-3" id="btnFirmaMasiva" onclick="abrirModalFirmaMasiva()">
                            <i class="fas fa-signature me-1"></i> Firmar Seleccionados
                            <span class="badge bg-white text-success ms-1 d-none" id="badgeSeleccionados" style="border:none;">0</span>
                        </button>
                    </div>
                </div>

                <!-- PESTAÑAS DE FILTRO RÁPIDO POR ESTADO -->
                <div class="filter-pills" id="quickFilterPills">
                    <button type="button" class="filter-pill active" data-quick="todos" onclick="seleccionarQuickFilter(this, 'todos')">
                        Todas <span class="pill-count tabular-nums"><%= listaInspecciones.length %></span>
                    </button>
                    <button type="button" class="filter-pill" data-quick="aprobado" onclick="seleccionarQuickFilter(this, 'aprobado')">
                        <i class="fas fa-circle text-success" style="font-size: 0.55rem;"></i> Aprobado
                        <span class="pill-count tabular-nums"><%= totalAprobadas %></span>
                    </button>
                    <button type="button" class="filter-pill" data-quick="defectos" onclick="seleccionarQuickFilter(this, 'defectos')">
                        <i class="fas fa-circle text-danger" style="font-size: 0.55rem;"></i> Con defectos
                        <span class="pill-count tabular-nums"><%= totalConDefectos %></span>
                    </button>
                    <button type="button" class="filter-pill" data-quick="pendiente" onclick="seleccionarQuickFilter(this, 'pendiente')">
                        <i class="fas fa-circle text-warning" style="font-size: 0.55rem;"></i> Pendiente
                        <span class="pill-count tabular-nums"><%= totalPendientes %></span>
                    </button>
                    <button type="button" class="filter-pill" data-quick="sin_firmar" onclick="seleccionarQuickFilter(this, 'sin_firmar')">
                        <i class="fas fa-pen-nib text-primary" style="font-size: 0.7rem;"></i> Sin firmar
                        <span class="pill-count tabular-nums"><%= totalSinFirmar %></span>
                    </button>
                </div>
            </div>

            <!-- BARRA DE FILTROS MULTICRITERIO -->
            <div class="filter-panel">
                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="filter-label">Búsqueda rápida</label>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-search"></i></span>
                            <input type="text" id="filtroTexto" class="form-control form-control-modern border-start-0 ps-0" placeholder="Ticket, placa o conductor..." oninput="aplicarFiltros(true)">
                        </div>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="filter-label">Placa</label>
                        <select id="filtroPlaca" class="form-select form-select-modern" onchange="aplicarFiltros(true)">
                            <option value="TODAS">Todas</option>
                            <% flotaActiva.forEach(veh => { %>
                                <option value="<%= veh.vehiculo_placa %>"><%= veh.vehiculo_placa %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="filter-label">Conductor</label>
                        <select id="filtroConductor" class="form-select form-select-modern" onchange="aplicarFiltros(true)">
                            <option value="TODOS">Todos</option>
                            <% conductoresUnicos.forEach(nombre => { %>
                                <option value="<%= nombre %>"><%= nombre %></option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="filter-label">Mes</label>
                        <select id="filtroMes" class="form-select form-select-modern" onchange="aplicarFiltros(true)">
                            <option value="TODOS">Todos los meses</option>
                            <option value="1">Enero</option>
                            <option value="2">Febrero</option>
                            <option value="3">Marzo</option>
                            <option value="4">Abril</option>
                            <option value="5">Mayo</option>
                            <option value="6">Junio</option>
                            <option value="7">Julio</option>
                            <option value="8">Agosto</option>
                            <option value="9">Septiembre</option>
                            <option value="10">Octubre</option>
                            <option value="11">Noviembre</option>
                            <option value="12">Diciembre</option>
                        </select>
                    </div>

                    <div class="col-6 col-md-2">
                        <label class="filter-label">Firma Operaciones</label>
                        <select id="filtroFirma" class="form-select form-select-modern" onchange="aplicarFiltros(true)">
                            <option value="TODAS">Todas</option>
                            <option value="no">Sin firmar</option>
                            <option value="si">Firmadas</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-1 d-grid">
                        <button type="button" class="btn btn-sm btn-outline-secondary bg-white fw-semibold" style="height: 35px;" onclick="limpiarFiltros()" title="Restablecer todos los filtros">
                            <i class="fas fa-eraser"></i><span class="d-md-none ms-1">Limpiar</span>
                        </button>
                    </div>
                </div>

                <!-- RANGO DE FECHAS DESPLEGABLE -->
                <div class="collapse mt-2 pt-2 border-top" id="filtrosAvanzados">
                    <div class="row g-2 align-items-end">
                        <div class="col-sm-6 col-md-3">
                            <label class="filter-label">Desde la fecha</label>
                            <input type="date" id="filtroDesde" class="form-control form-control-modern" onchange="aplicarFiltros(true)">
                        </div>
                        <div class="col-sm-6 col-md-3">
                            <label class="filter-label">Hasta la fecha</label>
                            <input type="date" id="filtroHasta" class="form-control form-control-modern" onchange="aplicarFiltros(true)">
                        </div>
                        <div class="col-sm-12 col-md-6 text-md-end">
                            <span class="text-muted" style="font-size: 0.74rem;">
                                <i class="fas fa-info-circle me-1"></i> Los filtros se combinan automáticamente y desmarcan filas ocultas para evitar firmas accidentales.
                            </span>
                        </div>
                    </div>
                </div>
            </div>
            
            <!-- TABLA DE REGISTROS -->
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 mobile-cards" id="tablaInspecciones">
                    <thead>
                        <tr>
                            <th class="ps-3" style="width: 42px;">
                                <input type="checkbox" id="selectAll" onclick="toggleSeleccionTodos(this)" class="form-check-input border-secondary" title="Seleccionar visibles en esta página">
                            </th>
                            <th>Ticket</th>
                            <th>Fecha / Hora</th>
                            <th>Vehículo</th>
                            <th>Conductor</th>
                            <th>Kilometraje</th>
                            <th>Estado y Firma</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyInspecciones">
                        <% if (listaInspecciones.length === 0) { %>
                            <tr class="fila-vacia-db">
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-inbox fs-2 mb-2 opacity-50"></i>
                                        <p class="mb-0 small">No hay registros de inspección disponibles.</p>
                                    </div>
                                </td>
                            </tr>
                        <% } else { %>
                            <% listaInspecciones.forEach(function(insp) { 
                                const fechaObj = new Date(insp.fecha_apertura);
                                const mesNum = fechaObj.getMonth() + 1;
                                const fechaISO = !isNaN(fechaObj) ? fechaObj.toISOString().split('T')[0] : '';
                                const estaFirmada = Boolean(insp.datos_chequeo?.firma_coordinador_img);
                                const nombreCond = insp.conductor?.nombre || 'Sin asignar';
                                const inicialesCond = nombreCond.trim().split(/\s+/).slice(0,2).map(n => n.charAt(0).toUpperCase()).join('');
                                const kmIni = insp.kilometraje_salida;
                                const kmFin = insp.datos_chequeo?.kilometraje_final || null;
                                const deltaKm = (kmIni && kmFin && !isNaN(kmIni) && !isNaN(kmFin) && Number(kmFin) >= Number(kmIni))
                                    ? (Number(kmFin) - Number(kmIni))
                                    : null;
                                const estadoTexto = (insp.estadoBadge || insp.estado || '').toLowerCase();
                                let estadoKey = 'pendiente';
                                if (estadoTexto.includes('aprobado')) estadoKey = 'aprobado';
                                else if (estadoTexto.includes('defecto')) estadoKey = 'defectos';
                            %>
                                <tr class="fila-inspeccion"
                                    data-ticket="#<%= String(insp.id).padStart(4, '0') %>"
                                    data-placa="<%= (insp.vehiculo_placa || '').toUpperCase() %>"
                                    data-conductor="<%= nombreCond.toLowerCase() %>"
                                    data-mes="<%= mesNum %>"
                                    data-fecha="<%= fechaISO %>"
                                    data-estado="<%= estadoKey %>"
                                    data-firmada="<%= estaFirmada ? 'si' : 'no' %>">
                                    
                                    <!-- CHECKBOX INDIVIDUAL -->
                                    <td class="ps-3" data-label="Selec:">
                                        <input type="checkbox" class="chk-inspeccion form-check-input border-secondary" value="<%= insp.id %>" onchange="actualizarContadorSeleccion()">
                                    </td>

                                    <!-- TICKET -->
                                    <td data-label="Ticket:" class="tabular-nums">
                                        <span class="fw-bold text-secondary">#<%= String(insp.id).padStart(4, '0') %></span>
                                    </td>
                                    
                                    <!-- FECHA Y HORA -->
                                    <td data-label="Fecha:" class="tabular-nums">
                                        <div class="d-flex flex-column text-end text-md-start">
                                            <span class="fw-semibold text-dark"><%= fechaObj.toLocaleDateString('es-ES') %></span>
                                            <span class="text-muted" style="font-size: 0.74rem;">
                                                <i class="far fa-clock me-1 opacity-75"></i><%= fechaObj.toLocaleTimeString('es-ES', {hour: '2-digit', minute:'2-digit'}) %>
                                            </span>
                                        </div>
                                    </td>
                                    
                                    <!-- VEHÍCULO -->
                                    <td data-label="Vehículo:">
                                        <span class="plate-badge">
                                            <i class="fas fa-car-side text-muted"></i> <%= insp.vehiculo_placa %>
                                        </span>
                                    </td>
                                    
                                    <!-- CONDUCTOR -->
                                    <td data-label="Conductor:">
                                        <div class="d-flex align-items-center justify-content-end justify-content-md-start gap-2">
                                            <span class="driver-avatar d-none d-md-inline-flex"><%= inicialesCond %></span>
                                            <span class="fw-medium text-dark"><%= nombreCond %></span>
                                        </div>
                                    </td>
                                    
                                    <!-- KILOMETRAJE + DELTA -->
                                    <td data-label="Kilometraje:" class="tabular-nums">
                                        <div>
                                            <span class="fw-bold text-dark"><%= kmIni %></span>
                                            <span class="text-muted mx-1">→</span>
                                            <span class="fw-semibold text-secondary"><%= kmFin || '-' %></span>
                                        </div>
                                        <% if (deltaKm !== null) { %>
                                            <span class="text-muted" style="font-size: 0.7rem;">+<%= deltaKm %> km recorridos</span>
                                        <% } %>
                                    </td>
                                    
                                    <!-- ESTADO + INDICADOR DE FIRMA -->
                                    <td data-label="Estado:">
                                        <div class="d-flex flex-column align-items-end align-items-md-start">
                                            <span class="badge <%= insp.badgeClass %>">
                                                <%= insp.estadoBadge %>
                                            </span>
                                            <% if (estaFirmada) { %>
                                                <span class="sign-status signed" title="Firmado por Operaciones">
                                                    <i class="fas fa-check-double"></i> Firmada
                                                </span>
                                            <% } else { %>
                                                <span class="sign-status unsigned" title="Pendiente de firma administrativa">
                                                    <i class="far fa-clock"></i> Sin firmar
                                                </span>
                                            <% } %>
                                        </div>
                                    </td>
                                    
                                    <!-- ACCIONES -->
                                    <td data-label="Acciones:" class="text-end-md pe-md-4">
                                        <div class="action-buttons">
                                            <a href="/admin/inspeccion/pdf/<%= insp.id %>" class="btn btn-action pdf" title="Descargar PDF" target="_blank">
                                                <i class="fas fa-file-pdf"></i> <span class="btn-text-mobile">PDF</span>
                                            </a>
                                            <a href="/admin/inspeccion/detalle/<%= insp.id %>" class="btn btn-action view" title="Ver Detalles">
                                                <i class="fas fa-eye"></i> <span class="btn-text-mobile">Detalle</span>
                                            </a>
                                            <a href="/admin/inspeccion/editar/<%= insp.id %>" class="btn btn-action edit" title="Editar / Firmar">
                                                <i class="fas fa-pen"></i> <span class="btn-text-mobile">Editar</span>
                                            </a>
                                            <% if (insp.estado === 'En curso') { %>
                                                <a href="/inspeccion/cierre/<%= insp.id %>" class="btn btn-action close-btn" title="Cerrar Jornada">
                                                    <i class="fas fa-flag-checkered"></i> <span class="btn-text-mobile">Cerrar</span>
                                                </a>
                                            <% } %>
                                            <form action="/admin/inspeccion/eliminar/<%= insp.id %>" method="POST" onsubmit="return confirm('¿Confirma la eliminación de este registro?');" style="display:inline;">
                                                <button type="submit" class="btn btn-action delete" title="Eliminar Registro">
                                                    <i class="fas fa-trash-alt"></i> <span class="btn-text-mobile">Borrar</span>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }); %>
                            <!-- FILA DE SIN RESULTADOS POR FILTRO -->
                            <tr id="filaSinResultados" style="display: none;">
                                <td colspan="8" class="text-center py-5">
                                    <div class="text-muted">
                                        <i class="fas fa-filter fs-2 mb-2 opacity-50"></i>
                                        <p class="mb-2 fw-semibold">No se encontraron inspecciones con los filtros actuales.</p>
                                        <button type="button" class="btn btn-sm btn-outline-primary fw-semibold" onclick="limpiarFiltros()">
                                            <i class="fas fa-undo me-1"></i> Limpiar filtros
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- BARRA DE PAGINACIÓN Y RESUMEN -->
            <% if (listaInspecciones.length > 0) { %>
                <div class="pagination-bar">
                    <div class="d-flex align-items-center gap-2 text-muted small">
                        <span>Mostrar</span>
                        <select id="selectPorPagina" class="form-select form-select-sm" style="width: auto;" onchange="cambiarPorPagina()">
                            <option value="15" selected>15</option>
                            <option value="30">30</option>
                            <option value="50">50</option>
                            <option value="99999">Todos</option>
                        </select>
                        <span id="infoPaginacion" class="tabular-nums">Mostrando registros</span>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary fw-semibold" id="btnPagAnterior" onclick="cambiarPagina(-1)">
                            <i class="fas fa-chevron-left me-1"></i> Anterior
                        </button>
                        <span class="small fw-semibold text-dark px-2 tabular-nums" id="indicadorPagina">Página 1 / 1</span>
                        <button type="button" class="btn btn-sm btn-outline-secondary fw-semibold" id="btnPagSiguiente" onclick="cambiarPagina(1)">
                            Siguiente <i class="fas fa-chevron-right ms-1"></i>
                        </button>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

    <div class="container-fluid mt-4">
        <div class="text-center" style="font-size: 0.76rem; color: #94a3b8;">
            <p class="mb-0">&copy; <%= new Date().getFullYear() %> OmegaGroup SAS · Plataforma Operativa y SST.</p>
        </div>
    </div>

