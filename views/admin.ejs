        // Mapa de última inspección única por placa + lista única de conductores
        const vehiculosMap = new Map();
        const conductoresSet = new Set();

        let totalAprobadas = 0;
        let totalConDefectos = 0;
        let totalPendientes = 0;
        let totalSinFirmar = 0;

        listaInspecciones.forEach(insp => {
            if (insp.vehiculo_placa) {
                if (!vehiculosMap.has(insp.vehiculo_placa)) {
                    vehiculosMap.set(insp.vehiculo_placa, insp);
                } else {
                    const existente = vehiculosMap.get(insp.vehiculo_placa);
                    if (new Date(insp.fecha_apertura) > new Date(existente.fecha_apertura)) {
                        vehiculosMap.set(insp.vehiculo_placa, insp);
                    }
                }
            }

            const nombreCond = insp.conductor?.nombre || 'Sin asignar';
            conductoresSet.add(nombreCond);

            const estLower = (insp.estadoBadge || insp.estado || '').toLowerCase();
            if (estLower.includes('aprobado')) totalAprobadas++;
            else if (estLower.includes('defecto')) totalConDefectos++;
            else totalPendientes++;

            if (!insp.datos_chequeo?.firma_coordinador_img) totalSinFirmar++;
        });

        const flotaActiva = Array.from(vehiculosMap.values()).sort((a, b) =>
            (a.vehiculo_placa || '').localeCompare(b.vehiculo_placa || '')
        );
        const conductoresUnicos = Array.from(conductoresSet).sort((a, b) => a.localeCompare(b));

        // 1. CÁLCULO DE KPIS DE DOCUMENTOS
        let docsVencidos = [];
        let docsPorVencer = [];
        const hoy = new Date();
        hoy.setHours(0, 0, 0, 0);

        // 2. CÁLCULO ESTADÍSTICO PARA CHART.JS
        let conteoEstados = {};
        let conteoFallas = {};

        flotaActiva.forEach(veh => {
            const datos = veh.datos_chequeo || {};
            const documentos = [
                { nombre: 'SOAT', fecha: datos.fecha_vencimiento_soat },
                { nombre: 'Tecnomecánica', fecha: datos.fecha_revision },
                { nombre: 'Póliza RCC', fecha: datos.doc_poliza_rcc },
                { nombre: 'Todo Riesgo', fecha: datos.doc_poliza_todo_riesgo },
                { nombre: 'Tarj. Operación', fecha: datos.doc_tarjeta_operacion }
            ];

            documentos.forEach(doc => {
                if (doc.fecha) {
                    const partes = doc.fecha.split('-');
                    if (partes.length === 3) {
                        const fechaDoc = new Date(partes[0], partes[1] - 1, partes[2]);
                        const diferencia = fechaDoc - hoy;
                        const diasRestantes = Math.ceil(diferencia / (1000 * 60 * 60 * 24));
                        if (diasRestantes < 0) {
                            docsVencidos.push({ placa: veh.vehiculo_placa, doc: doc.nombre, dias: Math.abs(diasRestantes) });
                        } else if (diasRestantes <= 30) {
                            docsPorVencer.push({ placa: veh.vehiculo_placa, doc: doc.nombre, dias: diasRestantes });
                        }
                    }
                }
            });

            let estadoVehiculo = veh.estadoBadge || veh.estado || 'No Definido';
            conteoEstados[estadoVehiculo] = (conteoEstados[estadoVehiculo] || 0) + 1;

            let items = veh.datos_chequeo?.chequeo_items || {};
            for (let key in items) {
                if (!key.startsWith('obs_') && items[key] === 'MALO') {
                    let nombreLimpio = key.replace(/^[a-z]+_/, '').replace(/_/g, ' ').toUpperCase();
                    conteoFallas[nombreLimpio] = (conteoFallas[nombreLimpio] || 0) + 1;
                }
            }
        });

        let topFallasArray = Object.entries(conteoFallas).sort((a, b) => b[1] - a[1]).slice(0, 5);
        let labelsEstados = Object.keys(conteoEstados);
