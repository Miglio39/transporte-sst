    <!-- ==============================================================
         LÓGICA EJS: DATOS DE PERFIL, KPIS, FILTROS Y GRÁFICOS
         ============================================================== -->
    <% 
        // Perfil seguro (funciona tanto si app.js envía "usuario" como si no)
        const adminPerfil = (typeof usuario !== 'undefined' && usuario)
            ? usuario
            : { nombre: 'Administrador', documento: 'Sesión verificada', rol: 'admin' };

        const inicialesAdmin = (adminPerfil.nombre || 'AD')
            .trim()
            .split(/\s+/)
            .slice(0, 2)
            .map(p => p.charAt(0).toUpperCase())
            .join('');

