<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Informe de Inspección - <%= inspeccion.placa %></title>
    <style>
        body {
            font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
            color: #2c3e50;
            font-size: 9px;
            margin: 0;
            padding: 0;
            line-height: 1.2;
        }
        
        .header-table { width: 100%; border-bottom: 2px solid #2c3e50; margin-bottom: 8px; padding-bottom: 5px; }
        .header-logo { max-width: 120px; max-height: 45px; display: block; }
        .header-text { text-align: right; vertical-align: bottom; }
        .header-text h1 { margin: 0; font-size: 16px; text-transform: uppercase; color: #2c3e50; }
        .header-text p { margin: 2px 0 0 0; font-size: 9px; color: #7f8c8d; }
        
        .meta-info { display: flex; justify-content: space-between; background: #f8f9fa; padding: 5px 8px; border: 1px solid #bdc3c7; border-radius: 4px; margin-bottom: 8px; font-size: 9px; }

        table { width: 100%; border-collapse: collapse; margin-bottom: 8px; }
        th, td { border: 1px solid #bdc3c7; padding: 3px 5px; text-align: left; }
        th { background-color: #ecf0f1; font-weight: bold; color: #2c3e50; }
        
        .section-title { background-color: #2c3e50; color: white; padding: 4px 6px; margin-top: 8px; margin-bottom: 4px; font-size: 10px; text-transform: uppercase; font-weight: bold; }
        
        .val-bueno { color: #27ae60; font-weight: bold; }
        .val-malo { color: #c0392b; font-weight: bold; }
        .val-na { color: #7f8c8d; }
        .estado-aprobado { color: #27ae60; font-weight: bold; }
        .estado-defectos { color: #c0392b; font-weight: bold; }
        .estado-pendiente { color: #f39c12; font-weight: bold; }

        .checklist-container { column-count: 2; column-gap: 15px; width: 100%; }
        .cat-box { break-inside: avoid; margin-bottom: 6px; }
        .cat-title { background-color: #e9ecef; color: #2c3e50; padding: 3px 5px; font-weight: bold; font-size: 9px; border: 1px solid #bdc3c7; border-bottom: none; }
        .check-table { font-size: 8.5px; margin-bottom: 0; }
        .check-table th { background-color: #f8f9fa; padding: 2px 4px; }
        .check-table td { padding: 2px 4px; }
        .status-col { text-align: center; width: 15%; font-weight: bold; }

        .firmas-table { width: 100%; margin-top: 15px; text-align: center; border: none; }
        .firmas-table td { border: none; padding: 10px; width: 50%; vertical-align: bottom; }
        .linea-firma { border-top: 1px solid #333; width: 80%; margin: 0 auto 3px auto; }
        
        .footer { text-align: center; font-size: 8px; color: #95a5a6; margin-top: 10px; border-top: 1px solid #eee; padding-top: 5px; }
    </style>
</head>
<body>

    <% 
        function formatStatus(val) {
            if(val === 'BUENO') return '<span class="val-bueno">✓ B</span>';
            if(val === 'MALO') return '<span class="val-malo">❌ M</span>';
            return '<span class="val-na">- NA</span>';
        }
        
        // Lógica blindada para formato DD/MM/YYYY
        function formatDate(dateInput) {
            if (!dateInput) return '';
            
            // Si es un texto tipo YYYY-MM-DD
            if (typeof dateInput === 'string' && dateInput.includes('-')) {
                const parts = dateInput.split('T')[0].split('-');
                if(parts.length === 3) return `${parts[2]}/${parts[1]}/${parts[0]}`;
            }
            
            // Si es un objeto Date
            const d = new Date(dateInput);
            if (isNaN(d.getTime())) return dateInput; 
            
            const dia = String(d.getDate()).padStart(2, '0');
            const mes = String(d.getMonth() + 1).padStart(2, '0');
            const anio = d.getFullYear();
            return `${dia}/${mes}/${anio}`;
        }

        const nombresCategorias = { 
            niveles: '1. NIVELES', pedales: '2. PEDALES', luces: '3. LUCES', 
            equipo: '4. EQUIPO DE PREVENCIÓN', varios: '5. VARIOS' 
        }; 
    %>

    <table class="header-table" style="border:none;">
        <tr>
            <td style="border:none; width: 30%; padding:0;">
                <% if (logoSrc) { %>
                    <img src="<%= logoSrc %>" class="header-logo">
                <% } else { %>
                    <div style="font-weight: bold; font-size:14px;">OmegaGroup</div>
                <% } %>
            </td>
            <td style="border:none; padding:0;" class="header-text">
                <h1>Reporte Preoperacional</h1>
                <p>Formato: <%= formatoCodigo %> | Reg: <strong><%= inspeccion.codigo_inspeccion %></strong></p>
            </td>
        </tr>
    </table>

    <div class="meta-info">
        <div><strong>Fecha:</strong> <%= formatDate(inspeccion.fecha_inspeccion) %></div>
        <div><strong>Entrada:</strong> <%= inspeccion.hora_inspeccion %></div>
        <div><strong>Salida:</strong> <%= inspeccion.hora_salida || 'Pendiente' %></div>
        <div><strong>Estado Final:</strong> 
            <span class="<%= inspeccion.estado === 'aprobado' ? 'estado-aprobado' : (inspeccion.estado === 'con_defectos' ? 'estado-defectos' : 'estado-pendiente') %>">
                <%= inspeccion.estado.toUpperCase() %>
            </span>
        </div>
    </div>

    <div class="section-title">Información del Conductor y Vehículo</div>
    <table>
        <tr>
            <th width="16%">Conductor</th>
            <td width="34%"><%= inspeccion.nombre_conductor %> <span style="color:#7f8c8d;">(CC: <%= inspeccion.cc_conductor || 'N/A' %>)</span></td>
            <th width="16%">Placa / Tipo</th>
            <td width="34%"><strong><%= inspeccion.placa %></strong> (<%= inspeccion.tipo_vehiculo || 'N/A' %>)</td>
        </tr>
        <tr>
            <th>Licencia Cond.</th>
            <td>N° <%= inspeccion.licencia_conductor %> <span style="color:#7f8c8d;">(Cat. <%= inspeccion.categoria_licencia %>)</span></td>
            <th>Modelo / Empresa</th>
            <td><%= inspeccion.modelo_vehiculo || 'N/A' %> / <%= inspeccion.empresa %></td>
        </tr>
        <tr>
            <th>Venc. Licencia</th>
            <td><%= formatDate(inspeccion.vigencia_licencia) %></td>
            <th>Licencia Tránsito</th>
            <td><%= inspeccion.doc_licencia_transito || '' %></td>
        </tr>
        <tr>
            <th>Venc. SOAT</th>
            <td><%= formatDate(inspeccion.fecha_vencimiento_soat) %></td>
            <th>Revisión Tecno.</th>
            <td><%= formatDate(inspeccion.fecha_revision) %></td>
        </tr>
        <tr>
            <th>Póliza RCC / RCE</th>
            <td><%= formatDate(inspeccion.doc_poliza_rcc) %></td>
            <th>Póliza Todo Riesgo</th>
            <td><%= formatDate(inspeccion.doc_poliza_todo_riesgo) %></td>
        </tr>
        <tr>
            <th>Tarjeta Operación</th>
            <td><%= formatDate(inspeccion.doc_tarjeta_operacion) %></td>
            <th>Cambio de Aceite</th>
            <td><%= formatDate(inspeccion.fecha_cambio_aceite) %></td>
        </tr>
        <tr>
            <th>Km Ent / Sal</th>
            <td><%= inspeccion.kilometraje_entrada %> / <%= inspeccion.kilometraje_salida || '-' %></td>
            <th>Recorrido Total</th>
            <td><strong><%= inspeccion.distancia_recorrida %> km</strong></td>
        </tr>
    </table>

    <div class="section-title">Lista de Chequeo Detallada (B=Bueno, M=Malo, NA=No Aplica)</div>
    <div class="checklist-container">
        <% for(let key in categorias) { %>
            <div class="cat-box">
                <div class="cat-title"><%= nombresCategorias[key] %></div>
                <table class="check-table">
                    <tr>
                        <th width="45%">Ítem</th><th width="15%">Est.</th><th width="40%">Observación</th>
                    </tr>
                    <% categorias[key].forEach(function(item) { %>
                        <tr>
                            <td><%= item.label %></td>
                            <td class="status-col"><%- formatStatus(item.valor) %></td>
                            <td style="color:#555;"><%= item.obs || '' %></td>
                        </tr>
                    <% }); %>
                </table>
            </div>
        <% } %>
    </div>

    <table style="border:none; margin-top: 5px;">
        <tr>
            <td style="border:none; width: 50%; padding-right: 5px; vertical-align: top;">
                <div class="section-title">Resumen de Evaluación</div>
                <table>
                    <tr>
                        <th>Buenos</th><td class="val-bueno"><%= inspeccion.total_bueno %></td>
                        <th>Malos</th><td class="val-malo"><%= inspeccion.total_malo %></td>
                        <th>N/A</th><td><%= inspeccion.total_na %></td>
                    </tr>
                </table>
                <div class="section-title">Observaciones Generales</div>
                <div style="border:1px solid #bdc3c7; padding: 5px; min-height: 25px; color:#555;">
                    <%= inspeccion.observaciones_generales || 'Ninguna observación registrada.' %>
                </div>
            </td>

            <td style="border:none; width: 50%; padding-left: 5px; vertical-align: top;">
                <% if (inspeccion.tiene_defectos === 1) { %>
                    <div class="section-title" style="background-color: #c0392b;">Defectos de Carrocería</div>
                    <div style="border:1px solid #c0392b; padding: 5px;">
                        <strong>Áreas:</strong> 
                        <span style="color:#c0392b;">
                            <%= inspeccion.defecto_frontal ? 'Frontal | ' : '' %>
                            <%= inspeccion.defecto_trasero ? 'Trasero | ' : '' %>
                            <%= inspeccion.defecto_lateral_izq ? 'Lat. Izq | ' : '' %>
                            <%= inspeccion.defecto_lateral_der ? 'Lat. Der | ' : '' %>
                            <%= inspeccion.defecto_motor ? 'Motor | ' : '' %>
                            <%= inspeccion.defecto_chasis ? 'Chasis' : '' %>
                        </span>
                        <br><br>
                        <strong>Detalle:</strong> <span style="color:#555;"><%= inspeccion.descripcion_defecto %></span>
                    </div>
                <% } else { %>
                    <div class="section-title" style="background-color: #27ae60;">Defectos de Carrocería</div>
                    <div style="border:1px solid #27ae60; padding: 5px; color:#27ae60; text-align:center; font-weight:bold;">
                        No se reportaron daños en carrocería.
                    </div>
                <% } %>
            </td>
        </tr>
    </table>

    <table class="firmas-table">
        <tr>
            <td>
                <% if (inspeccion.firma_conductor) { %>
                    <img src="<%= inspeccion.firma_conductor %>" style="max-height: 60px; margin-bottom: 5px;"><br>
                <% } else { %>
                    <div class="linea-firma"></div>
                <% } %>
                <strong><%= inspeccion.nombre_firma_conductor %></strong><br>
                Firma del Conductor (CC: <%= inspeccion.cc_conductor %>)
            </td>
            <td>
                <!-- AQUÍ INYECTAMOS LA FIRMA DEL ADMIN SI EXISTE -->
                <% if (inspeccion.firma_coordinador_img) { %>
                    <img src="<%= inspeccion.firma_coordinador_img %>" style="max-height: 60px; margin-bottom: 5px;"><br>
                <% } else { %>
                    <div class="linea-firma"></div>
                <% } %>
                <strong><%= inspeccion.firma_coordinador || 'Pendiente de firma' %></strong><br>
                Firma Coordinador/Supervisor (CC: <%= inspeccion.cc_coordinador || '---' %>)
            </td>
        </tr>
    </table>

    <div class="footer">
        Documento generado automáticamente por OmegaGroup el <%= fechaImpresion %>. Impreso por: <%= adminSolicitante %>
    </div>

</body>
</html>