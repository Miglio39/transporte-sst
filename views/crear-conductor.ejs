<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        body { background-color: #f4f6f9; padding: 20px; }
        .card { max-width: 500px; margin: 40px auto; border: none; box-shadow: 0 4px 15px rgba(0,0,0,0.1); }
        .card-header { background: #2c3e50; color: white; border-radius: 8px 8px 0 0 !important; }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="card-header p-3 text-center">
                <h4 class="mb-0"><i class="fas fa-user-plus"></i> Registrar Nuevo Conductor</h4>
            </div>
            <div class="card-body p-4">
                
                <% if (typeof error !== 'undefined') { %>
                    <div class="alert alert-danger"><i class="fas fa-exclamation-triangle"></i> <%= error %></div>
                <% } %>

                <form action="/admin/conductores/nuevo" method="POST">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre Completo</label>
                        <input type="text" name="nombre" class="form-control" required placeholder="Ej: Juan Pérez">
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label fw-bold">Número de Documento (CC)</label>
                        <input type="text" name="documento" class="form-control" required placeholder="Será su usuario para iniciar sesión">
                    </div>
                    
                    <div class="mb-4">
                        <label class="form-label fw-bold">Contraseña</label>
                        <input type="password" name="password" class="form-control" required placeholder="Cree una contraseña segura">
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success fw-bold p-2"><i class="fas fa-save"></i> GUARDAR CONDUCTOR</button>
                        <a href="/admin" class="btn btn-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>